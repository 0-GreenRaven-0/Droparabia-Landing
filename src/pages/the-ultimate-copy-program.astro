    <script>
      import Swiper from 'swiper';
      import { Navigation } from 'swiper/modules';
      import 'swiper/css';
      import 'swiper/css/navigation';

      document.querySelectorAll('.testimonials-swiper').forEach((swiperEl) => {
        const container = swiperEl.closest('.carousel-container');
        if (!container) return;
        new Swiper(swiperEl as HTMLElement, {
          modules: [Navigation],
          slidesPerView: 1,
          spaceBetween: 16,
          breakpoints: {
            600: { slidesPerView: 2, spaceBetween: 20 },
            1024: { slidesPerView: 3, spaceBetween: 24 },
          },
          loop: true,
          navigation: {
            nextEl: container.querySelector('.case-carousel-next') as HTMLElement,
            prevEl: container.querySelector('.case-carousel-prev') as HTMLElement,
          },
          pagination: false,
        });
      });
    </script>

    <script>
      document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = btn.dataset.faq!;
          const answer = document.getElementById(`faq-answer-${idx}`)!;
          const card = document.getElementById(`faq-card-${idx}`)!;
          const icon = btn.querySelector('.faq-icon')!;
          const isOpen = card.classList.contains('open');

          document.querySelectorAll('.faq-answer').forEach((a) => a.classList.remove('open'));
          document.querySelectorAll('.faq-card').forEach((c) => c.classList.remove('open'));
          document.querySelectorAll('.faq-icon').forEach((ic) => ic.classList.remove('open'));
          document.querySelectorAll('.faq-btn').forEach((b) => b.setAttribute('aria-expanded', 'false'));

          if (!isOpen) {
            answer.classList.add('open');
            card.classList.add('open');
            icon.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });

      // Clicking a buy CTA opens WhatsApp (the link itself) and moves the lead from the
      // unqualified list to the went-to-buy sheet. keepalive lets the request finish even
      // if the browser is backgrounded while the WhatsApp app opens.
      document.querySelectorAll<HTMLAnchorElement>('[data-buy-cta]').forEach((cta) => {
        cta.addEventListener('click', () => {
          try {
            if (sessionStorage.getItem('da_went_to_buy')) return;
            const user = JSON.parse(sessionStorage.getItem('userData') || '{}');
            if (!user.email) return;
            // A qualified lead stays on the booking follow-up list.
            const tokens = JSON.parse(sessionStorage.getItem('userTokens') || '{}');
            if (tokens.qualified && !tokens.unqualified) return;
            sessionStorage.setItem('da_went_to_buy', '1');

            const utms: Record<string, string> = {};
            ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((k) => {
              const v = sessionStorage.getItem(k);
              if (v) utms[k] = v;
            });
            let vsl: { watched?: number; furthest?: number; duration?: number } = {};
            try { vsl = JSON.parse(sessionStorage.getItem('da_vsl_at_survey') || '{}'); } catch {}

            fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              keepalive: true,
              body: JSON.stringify({
                name: user.name || '', email: user.email, phone: user.phone || '',
                list: 'went_to_buy_course',
                referrer: sessionStorage.getItem('da_referrer') || '',
                cta_popup: sessionStorage.getItem('da_cta_popup') || '',
                headline: sessionStorage.getItem('da_headline_variant') || '',
                vsl_watched_seconds: vsl.watched || 0,
                vsl_furthest_seconds: vsl.furthest || 0,
                vsl_duration_seconds: vsl.duration || 0,
                ...utms,
              }),
            }).catch(() => {});
          } catch {}
        });
      });

      document.querySelectorAll<HTMLElement>('.faq-card').forEach((card) => {
        card.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.closest('.faq-btn') || target.closest('.faq-answer')) return;
          card.querySelector<HTMLButtonElement>('.faq-btn')!.click();
        });
      });
    </script>

