---
import { siInstagram, siThreads, siYoutube } from 'simple-icons';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <title>The Ultimate Copy Program | Droparabia</title>
    <link rel="icon" type="image/png" href="/Droparabia.png" />

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      @font-face { font-family: 'IBrand'; src: url('/fonts/ibrand.woff2') format('woff2'), url('/fonts/ibrand.otf') format('opentype'); font-weight: normal; font-style: normal; font-display: swap; }
      html { scroll-behavior: smooth; }
      body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; background: #fff; color: #1F2937; }

      .site-header { position: relative; z-index: 5; background: #f0f0f0; box-shadow: 0 6px 24px rgba(0, 0, 0, 0.16); }
      .site-header-inner { width: 100%; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
      .corner-brand { display: flex; align-items: center; gap: 9px; text-decoration: none; }
      .corner-brand-logo { width: 36px; height: 36px; object-fit: contain; }
      .corner-brand-name { font-family: 'IBrand', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 1.5rem; line-height: 1; color: #000; letter-spacing: 0.01em; }
      .site-header-nav { display: flex; align-items: center; gap: 24px; }
      .site-header-link { font-family: 'IBrand', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 1.15rem; color: #000; text-decoration: none; white-space: nowrap; }
      .site-header-link:hover { text-decoration: underline; }
      @media (max-width: 400px) {
        .site-header-inner { padding: 12px 16px; }
        .site-header-nav { gap: 16px; }
      }
      .flex { display: flex; } .flex-col { flex-direction: column; } .items-center { align-items: center; }
      .justify-center { justify-content: center; } .text-center { text-align: center; }
      .text-gray-900 { color: #111827; } .text-gray-700 { color: #374151; } .text-gray-500 { color: #6B7280; }
      .leading-relaxed { line-height: 1.625; }
      .input--hidden { display: none !important; }

      .section { padding: 56px 24px; }
      .section--tint { background: #F8FAFC; }
      .section-inner { max-width: 880px; margin: 0 auto; }
      .section-inner--narrow { max-width: 680px; }
      /* Headings break out of their (narrower) content column, centered, up to 1100px. */
      .section-heading, .proof-heading {
        width: min(1100px, 100vw - 48px);
        max-width: none;
        margin-left: calc(50% - min(550px, 50vw - 24px));
        margin-right: 0;
      }
      .section-heading { font-size: clamp(1.5rem, 3.4vw, 2rem); font-weight: 800; color: #111827; text-align: center; margin-bottom: 40px; }

      /* Same brand gradient as droparabia-webinar's .gradient-text. */
      .gradient-text { background-image: linear-gradient(135deg, #001EFF 0%, #7200B0 100%); background-clip: text; -webkit-background-clip: text; color: transparent; }
      .faq-heading { font-family: 'IBrand', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 400; }

      .unq-btn {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 20px;
        border-radius: 14px;
        border: none;
        cursor: pointer;
        background: linear-gradient(135deg, #2563EB, #3B82F6);
        color: #fff;
        text-align: left;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 14px rgba(37,99,235,0.28);
        position: relative;
        overflow: hidden;
        width: 100%;
        max-width: 360px;
        text-decoration: none;
        margin: 0 auto;
      }
      .unq-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(37,99,235,0.35); }

      /* shine */
      .unq-btn::after {
        content: '';
        position: absolute;
        top: 0; left: -100%;
        width: 40%;
        height: 100%;
        background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.35), rgba(255,255,255,0));
        transform: skewX(-20deg);
        animation: unq-shine 2.5s ease-in-out infinite;
      }
      @keyframes unq-shine { 0%{left:-100%} 55%{left:130%} 100%{left:130%} }

      .unq-btn-txt1 { font-size: 1rem; font-weight: 700; margin: 0; }

      .price-line { font-size: 1.6rem; font-weight: 800; color: #111827; text-align: center; margin-bottom: 18px; }
      .price-line .price-row { display: flex; justify-content: center; align-items: baseline; gap: 20px; margin-top: 6px; line-height: 1; }
      .price-line .price-now { font-size: clamp(3.5rem, 9vw, 5.5rem); font-weight: 900; color: #16A34A; }
      .price-line .price-was { font-size: clamp(2.2rem, 5.5vw, 3.4rem); font-weight: 700; color: #6B7280; text-decoration: line-through; }

      .hero-attention-block { max-width: 1400px; margin: 0 auto 44px; text-align: center; }
      .hero-kicker { font-size: 0.9rem; font-weight: 700; color: #111827; line-height: 1.4; margin-bottom: 10px; }
      .hero-attention { font-size: 0.85rem; font-weight: 700; color: #2563EB; }
      .hero-headline { font-family: 'IBrand', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: clamp(1.85rem, 3.7vw, 2.9rem); font-weight: 400; color: #111827; line-height: 1.15; margin-bottom: 20px; }
      .hero-headline--top { text-align: center; max-width: 900px; margin: 0 auto 36px; }

      /* Sessions — cards scroll on the left while the laptop stays pinned on the right. */
      .sessions { background: linear-gradient(135deg, #0B1D42 0%, #16326B 50%, #1E3E7E 100%); padding: 88px 24px; }
      .sessions-row { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: start; }
      .sessions-list { display: flex; flex-direction: column; }
      .session-card { padding: 36px 0; border-bottom: 1px solid rgba(255,255,255,0.25); }
      .session-card:first-child { padding-top: 0; }
      .session-card:last-child { border-bottom: none; padding-bottom: 0; }
      .session-card h3 { font-family: 'IBrand', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 2.1rem; font-weight: 400; color: #fff; line-height: 1.2; margin-bottom: 14px; }
      .session-desc { font-size: 1rem; color: rgba(255,255,255,0.8); line-height: 1.6; margin-bottom: 16px; }
      .session-card ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
      .session-card li { position: relative; padding-left: 26px; font-size: 0.97rem; color: #fff; line-height: 1.5; }
      .session-card li::before { content: ''; position: absolute; left: 0; top: 0.3em; width: 14px; height: 14px; border-radius: 50%; background: #60A5FA; box-shadow: inset 0 0 0 4px rgba(255,255,255,0.35); }
      .sessions-media { position: sticky; top: max(24px, calc(50vh - 200px)); }
      .sessions-media img { display: block; width: 100%; height: auto; }
      @media (max-width: 900px) {
        .sessions { padding: 56px 20px; }
        .sessions-row { grid-template-columns: 1fr; gap: 28px; }
        .sessions-media { position: static; order: -1; }
        .session-card { padding: 28px 0; }
        .session-card h3 { font-size: 1.35rem; }
      }

      /* Offer — single centered column: name, book, pitch. */
      .offer { background: #fff; padding: 72px 24px; }
      .offer-inner { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center; }
      .offer-heading { font-family: 'IBrand', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 400; color: #111827; line-height: 1.15; margin-bottom: 28px; }
      .hero-image { display: block; width: 100%; height: auto; max-width: 540px; margin-bottom: 32px; filter: drop-shadow(0 20px 40px rgba(0,0,0,0.45)); }
      .hero-sub { font-size: 1.4rem; font-weight: 700; color: #111827; line-height: 1.5; }

      @media (max-width: 768px) {
        .offer { padding: 56px 20px; }
        .hero-image { max-width: 360px; }
        .hero-sub { font-size: 0.9rem; }
      }

      /* What's inside — priced list of included items beside the book, bonuses and CTA underneath. */
      .inside-row { max-width: 1240px; margin: 64px auto 0; display: grid; grid-template-columns: 1.5fr 1fr; gap: 32px; align-items: center; }
      .inside-row .included-card { order: -1; }
      /* Same transparent-margin crop as the bonus covers. */
      .inside-image { display: block; width: 100%; max-width: 380px; height: auto; margin: 0 auto; }
      .included-card { text-align: left; }
      .included-list { list-style: none; }
      .included-list li { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding: 14px 0; border-bottom: 1px solid rgba(0,0,0,0.14); font-size: 1.12rem; font-weight: 600; color: #111827; line-height: 1.45; }
      .included-list li:first-child { padding-top: 0; }
      .included-list li:last-child { border-bottom: none; padding-bottom: 0; }
      .included-price { flex-shrink: 0; font-size: 1.25rem; font-weight: 800; color: #6B7280; text-decoration: line-through; }
      .bonus-heading { max-width: 1240px; margin: 96px auto 24px; text-align: center; font-size: clamp(1.3rem, 2.6vw, 1.6rem); font-weight: 800; color: #111827; }
      .bonus-grid { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
      .bonus-card { display: flex; align-items: center; gap: 8px; text-align: left; }
      /* The cover PNGs have wide transparent margins; a tall, slightly left-of-center cover crop keeps just the book. */
      .bonus-image { flex: 0 0 200px; width: 200px; aspect-ratio: 0.57; object-fit: cover; object-position: 47% 50%; }
      .bonus-card h4 { font-size: 1.35rem; font-weight: 700; color: #111827; line-height: 1.35; margin-bottom: 8px; }
      .bonus-card p { font-size: 0.92rem; color: #4B5563; line-height: 1.55; }
      .inside-cta { margin-top: 48px; text-align: center; }
      /* Trust badges under the price: four equal columns, icon above a short label. */
      .price-badges { list-style: none; max-width: 1100px; margin: 20px auto 40px; display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px; }
      .price-badges li { display: flex; flex-direction: column; align-items: center; gap: 12px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; line-height: 1.45; text-transform: uppercase; color: #111827; text-align: center; }
      .price-badges .badge-icon { display: flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #2563EB, #3B82F6); color: #fff; box-shadow: 0 4px 14px rgba(37,99,235,0.28); }
      .price-badges svg { width: 26px; height: 26px; }
      @media (max-width: 900px) {
        .inside-row { grid-template-columns: 1fr; gap: 28px; margin-top: 48px; }
        .inside-image { max-width: 260px; }
        .inside-row .included-card { order: 0; }
        .bonus-heading { margin-top: 64px; }
        .bonus-grid { grid-template-columns: 1fr; gap: 16px; }
        .bonus-card h4 { font-size: 1.15rem; }
        .bonus-card p { font-size: 0.84rem; line-height: 1.5; }
        .bonus-card { gap: 6px; }
        .bonus-image { flex-basis: 130px; width: 130px; }
        .price-badges { grid-template-columns: 1fr 1fr; max-width: 420px; gap: 24px 16px; margin: 16px auto 32px; }
        .price-badges li { font-size: 0.7rem; letter-spacing: 0.04em; gap: 8px; }
        .price-badges .badge-icon { width: 44px; height: 44px; }
        .price-badges svg { width: 22px; height: 22px; }
        .price-badges li:last-child:nth-child(odd) { grid-column: 1 / -1; max-width: 50%; margin: 0 auto; }
      }

      /* Testimonials placeholder — no fabricated names/quotes; swap this in once real
         reviews come in after the first cohort. */

      /* Free guide bonus, above the FAQ. The cover render already has its own shadow/
         perspective baked in, so it's shown as-is rather than cropped like the book
         covers above. */
      .free-guide-section { background: linear-gradient(135deg, #0B1D42 0%, #16326B 50%, #1E3E7E 100%); }
      .free-guide-card { display: flex; align-items: center; gap: 48px; max-width: 900px; margin: 0 auto; }
      .free-guide-cover { flex: 0 0 260px; width: 260px; height: auto; display: block; filter: drop-shadow(0 16px 30px rgba(0,0,0,0.35)); }
      .free-guide-copy { flex: 1; text-align: left; }
      .free-guide-heading { font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 800; color: #fff; line-height: 1.25; margin-bottom: 14px; }
      .free-guide-desc { font-size: 1rem; color: rgba(255,255,255,0.8); line-height: 1.6; margin-bottom: 22px; }
      .free-guide-btn { margin: 0; max-width: 320px; background: #fff; color: #16326B; box-shadow: 0 4px 14px rgba(0,0,0,0.25); }
      @media (max-width: 700px) {
        .free-guide-card { flex-direction: column; text-align: center; gap: 24px; }
        .free-guide-cover { flex-basis: 200px; width: 200px; }
        .free-guide-copy { text-align: center; }
        .free-guide-btn { margin: 0 auto; }
      }

      /* FAQ */
      /* FAQ accordion — same styling/behavior as droparabia-webinar's FAQ.astro,
         with its rgba(0,0,0,..) borders/hover glow swapped for the site's blue. */
      .faq-list { display: flex; flex-direction: column; gap: 1rem; }
      .faq-card {
        background: #fff;
        border: 2px solid rgba(0,0,0,0.1);
        border-radius: 1rem;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
        cursor: pointer;
      }
      .faq-card:hover {
        border-color: rgba(37,99,235,0.5);
        box-shadow: 0 6px 24px rgba(0,0,0,0.12), 0 0 0 4px rgba(37,99,235,0.08);
      }
      .faq-card.open {
        border-color: rgba(37,99,235,0.65);
        background: rgba(37,99,235,0.06);
        box-shadow: 0 6px 28px rgba(0,0,0,0.14), 0 0 0 4px rgba(37,99,235,0.1);
      }
      .faq-btn { width: 100%; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; text-align: left; background: none; border: none; padding: 0; cursor: pointer; font: inherit; }
      .faq-btn span { font-weight: 700; font-size: 1rem; line-height: 1.4; color: #111827; padding-top: 0.125rem; }
      .faq-answer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease; overflow: hidden; }
      .faq-answer.open { grid-template-rows: 1fr; }
      .faq-answer > p { overflow: hidden; font-size: 0.92rem; color: #4B5563; line-height: 1.6; padding-top: 0.75rem; }
      .faq-icon { flex-shrink: 0; margin-top: 0.125rem; color: #2563EB; transition: transform 0.3s ease; }
      .faq-icon.open { transform: rotate(180deg); }

      /* Footer — same as the homepage's. */
      .footer { background: #f0f0f0; color: #0b1230; padding: 40px 0 0; box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.16); }
      .footer-inner { max-width: 1040px; margin: 0 auto; padding: 0 20px 32px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 28px; }
      .footer-logo-link { display: flex; align-items: center; gap: 10px; text-decoration: none; }
      .footer-logo-img { width: 34px; height: 34px; object-fit: contain; }
      .footer-logo-name { font-family: 'IBrand', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 1.4rem; color: #0b1230; }
      .footer-links-label { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #7b8098; margin-bottom: 10px; }
      .footer-compliance { display: grid; gap: 7px; }
      .footer-compliance-link { font-size: 0.88rem; color: #4a5170; text-decoration: none; transition: color 0.2s ease; }
      .footer-compliance-link:hover { color: #0b1230; }
      .footer-socials { display: flex; gap: 10px; }
      .footer-social-link { width: 34px; height: 34px; border-radius: 50%; background: #dcdbd9; color: #4a5170; display: flex; align-items: center; justify-content: center; transition: background 0.2s ease, color 0.2s ease; }
      .footer-social-link:hover { background: #001eff; color: #fff; }
      .footer-social-link svg { width: 17px; height: 17px; }
      .footer-bottom { border-top: 1px solid #dcdbd9; padding: 16px 20px; text-align: center; }
      .footer-bottom p { font-size: 0.8rem; color: #7b8098; }

      /* Social-proof grid — 2 columns on desktop, 1 on mobile. */
      .proof-grid-container { max-width: 860px; margin: 40px auto 0; padding: 0 24px; }
      .proof-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
      .proof-grid img { display: block; width: 100%; height: auto; border-radius: 16px; box-shadow: 0 14px 32px -8px rgba(0, 0, 0, 0.32); }
      .proof-heading { font-size: 1.4rem; }
      .hero-proof { padding-top: 28px; }
      @media (max-width: 768px) {
        .hero-proof { padding-top: 20px; padding-left: 0; padding-right: 0; }
        .hero-proof .section-inner, .hero-proof .hero-attention-block { padding: 0 20px; }
        .proof-heading { font-size: 1.1rem; }
        .proof-grid-container { padding: 0 6px; }
        .proof-grid { gap: 16px; }
      }

      /* Social-proof carousel — same setup as the homepage's case-studies swiper. */
      .carousel-container { position: relative; max-width: 1152px; margin: 40px auto 0; padding: 0 24px; }
      .testimonials-swiper { overflow: hidden; }
      .swiper-slide { overflow: hidden; border-radius: 16px; box-shadow: 0 14px 32px -8px rgba(0, 0, 0, 0.32); }
      .swiper-slide img { display: block; width: 100%; height: auto; }
      .case-carousel-nav {
        position: absolute;
        top: 50%;
        z-index: 10;
        width: 44px;
        height: 44px;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #2745ff, #001eff 45%, #000c66);
        box-shadow: 0 6px 16px -6px rgba(0, 30, 255, 0.35);
        transition: transform 0.15s ease-out;
      }
      .case-carousel-prev { left: 0; transform: translate(-50%, -50%); }
      .case-carousel-next { right: 0; transform: translate(50%, -50%); }
      .case-carousel-prev:hover { transform: translate(-50%, -50%) scale(1.1); }
      .case-carousel-next:hover { transform: translate(50%, -50%) scale(1.1); }
      /* Arrows sit inside the screen on mobile — hanging half off-edge made the page scroll sideways. */
      @media (max-width: 768px) {
        .carousel-container { padding: 0 48px; overflow-x: clip; }
        .case-carousel-nav { width: 36px; height: 36px; }
        .case-carousel-prev, .case-carousel-prev:hover { left: 6px; transform: translateY(-50%); }
        .case-carousel-next, .case-carousel-next:hover { right: 6px; transform: translateY(-50%); }
      }
    </style>
    <!-- Meta Pixel Code -->
    <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '4560443994198158');
    fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=4560443994198158&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
  </head>

  <body>

    <div id="main-content">

      <!-- ═══════════ SITE HEADER ═══════════ -->
      <header class="site-header">
        <div class="site-header-inner">
          <a href="/" class="corner-brand" aria-label="Droparabia">
            <img src="/Droparabia.png" alt="" class="corner-brand-logo" width="36" height="36" />
            <span class="corner-brand-name">Droparabia</span>
          </a>
          <nav class="site-header-nav">
            <a href="#faq" class="site-header-link">FAQ</a>
            <a href="#reviews" class="site-header-link">Reviews</a>
          </nav>
        </div>
      </header>

      <!-- ═══════════ HERO — COPY PROGRAM TESTIMONIALS ═══════════ -->
      <section class="section hero-proof">
        <div class="hero-attention-block" id="hero-attention-block" hidden>
          <p class="hero-kicker">
            Based on your answers, it seems now is not the right time for you to join Droparabia
          </p>
          <p class="hero-attention">
            But we've got something suitable for you at the moment
          </p>
        </div>
        <script is:inline>
          // Only unqualified leads routed here by the survey (?unq=<token>) see the
          // attention line. If this tab also holds the survey's token, they must match.
          (function () {
            try {
              var unq = new URLSearchParams(window.location.search).get('unq');
              if (!unq || !/^[a-z0-9]{8,40}$/.test(unq)) return;
              var stored = '';
              try { stored = (JSON.parse(sessionStorage.getItem('userTokens') || '{}') || {}).unqualified || ''; } catch (_) {}
              if (stored && stored !== unq) return;
              document.getElementById('hero-attention-block').hidden = false;
            } catch (_) {}
          })();
        </script>

        <div class="section-inner">
          <h1 class="hero-headline hero-headline--top">
            Learn a high-paying skill that every online business will pay you for
          </h1>
        </div>

        <!-- Sibling to .section-inner so the grid's own max-width isn't choked by it. -->
        <div class="proof-grid-container">
          <div class="proof-grid">
            <img src="/copy-program/Ibrahim.png" alt="Testimonial" loading="lazy" />
            <img src="/copy-program/Marie.png" alt="Testimonial" loading="lazy" />
            <img src="/copy-program/al%20ghoche.png" alt="Testimonial" loading="lazy" />
            <img src="/copy-program/alex.png" alt="Testimonial" loading="lazy" />
