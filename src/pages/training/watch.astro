  }

  .tp-date {
    flex-shrink: 0;
    font-size: 0.85rem;
    color: var(--da-ink-mute);
  }

  /* Height drives the size; the 512x96 viewBox keeps the five squares in proportion. */
  .tp-stars-img {
    display: block;
    height: 24px;
    width: auto;
    margin-bottom: 14px;
