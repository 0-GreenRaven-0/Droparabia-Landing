  }

  /* ══════════════ RESPONSIVE ══════════════ */
  @media (max-width: 640px) {
    .headline-sub { font-size: 0.78rem; }
    /* Ordered after .headline-sub so the smaller size wins at equal weight. */
    /* Two classes, matching the desktop rules above: a media query adds no specificity,
       so a single-class rule here loses to .headline-sub.headline-sub--detail and the
       phone kept rendering the desktop size. */
    .headline-sub.headline-sub--detail { font-size: 0.62rem; line-height: 1.45; margin-bottom: 16px; }
    .headline-sub.headline-sub--lead { margin-bottom: 4px; }
    .section-heading { font-size: 1.1rem; gap: 8px; }
    .heading-arrow { width: 20px; height: 26px; }
    /* Tighter above the headline on a phone: the header bar already separates it from
       the top of the screen, so the full 40px was pushing the video down for nothing. */
    /* Before they subscribe, the progress bar and the CTA are display:none and take no
       room, so the carousel closes right up under the video and fills the screen instead
       of leaving a blank strip there. Subscribing reveals those two, which take the space
       back and push the carousel down — no class toggling needed, since the gap being
       collapsed is only ever the space they will occupy. */
    /* The bottom gap can't go below the video's glow: .hero clips its overflow, so a
       shorter padding than the shadow's reach (16px down, 40px blur) shears it off. */
    .hero { padding: 18px 0 26px; }
    .vsl-wrapper { margin-bottom: 24px; }
    .proof-section { padding-top: 18px; }
    .carousel-container { margin-top: 16px; }
    .site-header-inner { padding: 10px 16px; }
    .corner-brand { gap: 7px; }
    .corner-brand-logo { width: 28px; height: 28px; }
    .corner-brand-name { font-size: 1.15rem; }
    .site-header-link { font-size: 0.82rem; }
    .headline { max-width: none; }
    .vsl-wrapper { border-radius: 14px; box-shadow: 0 0 0 3px var(--da-blue), 0 16px 40px rgba(0, 30, 255, 0.18); }
    .carousel-container { padding: 0 26px; }
    /* left:0/right:0 resolve to the container's outer edge regardless of its padding
       (padding never shifts that reference point for an absolutely-positioned child) —
       straddling that edge on mobile meant half the button hung off the viewport itself.
       Sitting fully inside instead, overlaid on the slide. */
    .case-carousel-nav { width: 36px; height: 36px; top: 50%; transform: translateY(-50%) !important; }
    .case-carousel-prev { left: 8px; }
    .case-carousel-next { right: 8px; }
    .footer-inner { flex-direction: column; gap: 24px; }
  }
