  /* Gradient pills straddling the container edges, per the official reviews page. */
  .case-carousel-nav {
    position: absolute;
    top: 50%;
    z-index: 10;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
