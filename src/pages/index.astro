  .case-carousel-prev:hover { transform: translate(-50%, -50%) scale(1.1); }
  .case-carousel-next:hover { transform: translate(50%, -50%) scale(1.1); }

  /* ══════════════ FOOTER ══════════════ */
  .footer {
    background: var(--da-navy);
    color: #fff;
    padding: 40px 0 0;
  }

  .footer-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 20px 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 28px;
  }

  .footer-logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .footer-logo-img {
    width: 34px;
