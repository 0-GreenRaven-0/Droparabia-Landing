<script>
  import Swiper from 'swiper';
  import { Navigation } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';

  // Initialised straight away, matching the official reviews page. The previous
  // IntersectionObserver deferral meant the carousel was still booting as it scrolled
  // into view, which is what made it feel less smooth than that one.
  document.querySelectorAll('.testimonials-swiper').forEach((swiperEl) => {
    const container = swiperEl.closest('.carousel-container');
    if (!container) return;
    new Swiper(swiperEl as HTMLElement, {
      modules: [Navigation],
      slidesPerView: 1,
      spaceBetween: 16,
      breakpoints: {
        600: { slidesPerView: 2, spaceBetween: 20 },
        1024: { slidesPerView: 3, spaceBetween: 24 },
      },
      loop: true,
      navigation: {
        nextEl: container.querySelector('.case-carousel-next') as HTMLElement,
        prevEl: container.querySelector('.case-carousel-prev') as HTMLElement,
      },
      pagination: false,
    });
  });
</script>

<script>
  import Plyr from 'plyr';
  import 'plyr/dist/plyr.css';

  const player = new Plyr('#vsl-player', {
    // Progress bar and keyboard seeking are both back on — scrubbing is fine as long
    // as it's constrained to ground already covered. See the 'seeking' clamp below,
    // which is what actually stops anyone from dragging or arrow-keying ahead.
    controls: ['play-large', 'play', 'progress', 'current-time', 'duration', 'fullscreen'],
    resetOnEnd: false,
  });

  function getTrackingData(): Record<string, string> {
    const result: Record<string, string> = {};
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((k) => {
      const v = sessionStorage.getItem(k);
      if (v) result[k] = v;
    });
    const ref = sessionStorage.getItem('da_referrer');
    if (ref) result.referrer = ref;
    const headline = sessionStorage.getItem('da_headline_variant');
    if (headline) result.headline = headline;
    // Meta click/browser ids, for the sheet's offline-conversion columns.
    const ad = (window as any).daAdClick ? (window as any).daAdClick() : { fbc: '', fbp: '' };
    if (ad.fbc) result.fbc = ad.fbc;
    if (ad.fbp) result.fbp = ad.fbp;
    return result;
  }

  function isValidEmail(raw: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(raw.trim());
  }

  // The national part, with any country code they retyped and the trunk zero removed.
  function nationalDigits(dial: string, raw: string): string {
    let d = (raw || '').replace(/\D/g, '');
    if (d.startsWith('00' + dial)) d = d.slice(dial.length + 2);
    else if (d.startsWith(dial) && d.length > dial.length + 5) d = d.slice(dial.length);
    return d.replace(/^0+/, '');
  }

  // Lebanese numbers keep the stricter check they've always had; for every other country
  // the number only has to be a plausible length (E.164 allows 15 digits in total).
  function isValidPhone(dial: string, raw: string): boolean {
    const d = nationalDigits(dial, raw);
    if (dial === '961') return /^\d{7,8}$/.test(d);
    return d.length >= 5 && (dial + d).length <= 15;
  }

  // ── Subscription modal: opens when Plyr's own play button is clicked while
  // unsubscribed. No overlay/lock on the video itself — it looks and behaves like a
  // normal player; the gate only kicks in on the play action.
  const modal = document.getElementById('vsl-modal') as HTMLElement;
  const modalClose = document.getElementById('vsl-modal-close') as HTMLElement;
  const modalForm = document.getElementById('vsl-modal-form') as HTMLFormElement;

  function openModal() {
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
  }

  // ── VSL watch tracking ─────────────────────────────────────────────────────
  // Kept in sessionStorage so /survey can report how much of the video they'd seen
  // before leaving to book. Two numbers, because they answer different questions:
  // "watched" is time actually played (a seek forward doesn't earn credit, a rewatch
  // doesn't double-count), "furthest" is the deepest point they reached. Declared here
  // (ahead of the book-cta section below) because showBookCta needs furthestSeconds
  // to set the CTA's initial lock state for a returning, already-subscribed visitor.
  const WATCH_KEY = 'da_vsl_watch';
  // Same figures, mirrored into localStorage. sessionStorage alone loses this the
  // moment the tab closes, so anyone who watches the VSL and comes back later (a
  // different tab, a bookmark, the next day) to finish the survey or book would
  // otherwise report as having watched nothing. localStorage survives that; read as
  // a fallback wherever this data gets sent, never as the primary source.
  const WATCH_PERSIST_KEY = 'da_vsl_watch_persist';
  const BOOK_UNLOCK_RATIO = 0.4; // must watch 40% of the VSL to unlock booking
  let watchedSeconds = 0;
  let furthestSeconds = 0;
  let lastTick = 0;
  let lastSaved = 0;

  try {
    const prior = JSON.parse(sessionStorage.getItem(WATCH_KEY) || '{}');
    watchedSeconds = Number(prior.watched) || 0;
    furthestSeconds = Number(prior.furthest) || 0;
  } catch { /* nothing recorded yet */ }

  function saveWatch() {
    const payload = JSON.stringify({
      watched: Math.round(watchedSeconds),
      furthest: Math.round(furthestSeconds),
      duration: Math.round(player.duration || 0),
    });
    try { sessionStorage.setItem(WATCH_KEY, payload); } catch { /* storage unavailable — tracking is best-effort */ }
    try { localStorage.setItem(WATCH_PERSIST_KEY, payload); } catch { /* same */ }
  }

  // Book-a-call CTA: hidden until the VSL is actually unlocked, so it shows up the
  // moment subscribing succeeds — and immediately on load for a returning visitor
  // who already subscribed earlier this session. Even once shown it stays locked
  // (grey, inert) until 40% of the VSL has been watched.
  const bookCta = document.getElementById('book-cta') as HTMLElement | null;
  const bookCtaGate = document.getElementById('book-cta-gate') as HTMLElement | null;
  const progressWrap = document.getElementById('vsl-progress-wrap') as HTMLElement | null;
  const progressBar = document.getElementById('vsl-progress-bar') as HTMLElement | null;
  const progressLabel = document.getElementById('vsl-progress-label') as HTMLElement | null;

  function updateWatchProgressUI() {
    const dur = player.duration || 0;
    const pct = dur > 0 ? Math.min(100, Math.round((furthestSeconds / dur) * 100)) : 0;
    if (progressBar) progressBar.style.width = pct + '%';
    if (progressLabel) progressLabel.textContent = pct + '% watched';

    const unlocked = dur > 0 && furthestSeconds / dur >= BOOK_UNLOCK_RATIO;
    if (bookCta) {
      bookCta.classList.toggle('is-locked', !unlocked);
      bookCta.setAttribute('aria-disabled', unlocked ? 'false' : 'true');
    }
    // This runs on every timeupdate tick regardless of subscription state (the video's
    // preload="metadata" fires loadedmetadata on its own), so without the subscribed
    // check the gate line would leak into view before anyone's actually subscribed.
    if (bookCtaGate) {
      const subscribed = !!sessionStorage.getItem('da_subscribed');
      bookCtaGate.style.display = subscribed && !unlocked ? 'block' : 'none';
    }
  }

  // Weekly spots left, counted server-side from this week's rows on the booked sheet.
  // The fallback text stays in place if the request fails.
  const spotsEl = document.getElementById('book-cta-spots');
  if (spotsEl) {
    fetch('/api/spots')
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then((data: { remaining?: number }) => {
        if (typeof data.remaining !== 'number') return;
        const n = data.remaining;
        spotsEl.textContent = n === 0
          ? 'No spots left this week'
          : n === 1
            ? '1 spot is available this week'
            : `${n} spots are available this week`;
      })
      .catch(() => {});
  }

  function showBookCta() {
    if (bookCta) bookCta.style.display = 'flex';
    if (progressWrap) progressWrap.style.display = 'flex';
    updateWatchProgressUI();
  }
  if (sessionStorage.getItem('da_subscribed')) showBookCta();

  // A locked CTA is also pointer-events:none in CSS, but that alone won't stop a
  // keyboard Enter/Space activation — belt and suspenders.
  bookCta?.addEventListener('click', (e) => {
    if (bookCta.classList.contains('is-locked')) e.preventDefault();
  });

  player.on('play', () => {
    if (!sessionStorage.getItem('da_subscribed')) {
      player.pause();
      openModal();
    }
  });

  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  modalForm.addEventListener('submit', async function (e) {
    e.preventDefault();
    const btn = this.querySelector('button[type="submit"]') as HTMLButtonElement;
    const btnText = btn.textContent;
    const successEl = document.getElementById('vsl-success-msg') as HTMLElement;
    const errorEl = document.getElementById('vsl-error-msg') as HTMLElement;
    const nameVal = (this.querySelector('[name="FIRSTNAME"]') as HTMLInputElement)?.value ?? '';
    const emailVal = (this.querySelector('[name="EMAIL"]') as HTMLInputElement)?.value ?? '';
    const dialVal = (this.querySelector('[name="SMS__COUNTRY_CODE"]') as HTMLSelectElement)?.value || '961';
    const smsRaw = (this.querySelector('[name="SMS"]') as HTMLInputElement)?.value ?? '';
    // Sent in full international form, so a non-Lebanese lead is still reachable.
    const smsVal = isValidPhone(dialVal, smsRaw) ? '+' + dialVal + nationalDigits(dialVal, smsRaw) : '';
    const phoneErrEl = document.getElementById('vsl-modal-phone-err') as HTMLElement | null;
    const emailErrEl = document.getElementById('vsl-modal-email-err') as HTMLElement | null;

    successEl.style.display = 'none';
    errorEl.style.display = 'none';

    // Validate the email here rather than letting Brevo reject it — an invalid address
    // came back as a generic "Could not subscribe. Please try again.", which gave the
    // visitor no idea which field was actually wrong.
    if (!isValidEmail(emailVal)) {
      if (emailErrEl) emailErrEl.style.display = 'block';
      return;
    }
    if (emailErrEl) emailErrEl.style.display = 'none';

    if (!smsVal) {
      if (phoneErrEl) phoneErrEl.style.display = 'block';
      return;
    }
    if (phoneErrEl) phoneErrEl.style.display = 'none';

    btn.disabled = true;
    btn.textContent = 'Subscribing...';

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: nameVal, email: emailVal, phone: smsVal, list: 'vsl', ...getTrackingData() }),
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.error);

      sessionStorage.setItem('da_subscribed', '1');
      sessionStorage.setItem('userData', JSON.stringify({ name: nameVal, email: emailVal, phone: smsVal }));
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'subscription_success_modal' });
      // Meta Pixel advanced matching: every page's pixel init reads this back and passes
      // it as { em, ph } (/choose-schedule also passes fn and ln, for Schedule). Plain
      // values; the pixel hashes them itself. The phone becomes digits only with the 961
      // country code, no +, spaces or leading zeros.
      // Already in full international form; Meta wants it as digits with no plus.
      const ph = smsVal.replace(/\D/g, '');
      const em = emailVal.trim().toLowerCase();
      // The form has a single full-name field: the first word is fn, everything after
      // the first space is ln (left empty, and never sent, when there isn't one).
      const fullName = nameVal.trim().toLowerCase().replace(/\s+/g, ' ');
      const space = fullName.indexOf(' ');
      const fn = space === -1 ? fullName : fullName.slice(0, space);
      const ln = space === -1 ? '' : fullName.slice(space + 1);
      try {
        localStorage.setItem('da_match', JSON.stringify({ em, ph, fn, ln }));
      } catch {}
      // Advanced matching only: the page's init ran before they typed anything, so it's
      // re-run with what they just submitted. Lead is no longer fired here — it belongs
      // to the qualification point in the survey (see SurveyFlow), so it measures
      // qualified leads rather than everyone who unlocked the video.
      try {
        const fbq = (window as any).fbq;
        if (typeof fbq === 'function') {
          const match: Record<string, string> = {};
          if (em) match.em = em;
          if (ph) match.ph = ph;
          if (fn) match.fn = fn;
          if (ln) match.ln = ln;
          fbq('init', '4560443994198158', match);
        }
      } catch {}

      successEl.style.display = 'block';
      btn.textContent = 'Starting video...';
      closeModal();
      showBookCta();
      player.play();
    } catch {
      errorEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = btnText;
    }
  });

  // A tick counts as playback only if the video moved forward no faster than the clock
  // did since the last one. That's what tells a seek apart from real watching, however
  // far apart the ticks land: a background tab or busy phone can space them seconds
  // apart and it's still all watched, while a jump ahead covers far more video than
  // time elapsed. The slack absorbs timer jitter; the VSL has no speed control.
  let lastTickAt = 0;
  function resetTick() { lastTick = player.currentTime; lastTickAt = performance.now(); }
  function isPlaybackStep(delta: number, now: number): boolean {
    const elapsed = (now - lastTickAt) / 1000;
    return delta > 0 && delta <= elapsed * 1.25 + 0.25;
  }
  player.on('play', resetTick);
  player.on('seeked', resetTick);
  player.on('pause', saveWatch);
  player.on('ended', saveWatch);
  window.addEventListener('pagehide', saveWatch);

  // Let them scrub freely within what they've already watched — rewatching a scene
  // is fine — but snap back any drag/click/arrow-key seek that lands past the
  // furthest point reached. 'seeking' fires with the target time already applied to
  // the media element, so this is the one place that can actually block a skip-ahead
  // before it plays; a small buffer absorbs float rounding at the boundary itself.
  const SEEK_CLAMP_BUFFER = 0.5;
  player.on('seeking', () => {
    if (player.currentTime > furthestSeconds + SEEK_CLAMP_BUFFER) {
      player.currentTime = furthestSeconds;
    }
  });

  // Duration isn't known until metadata loads — re-check the lock/progress state
  // once it is, for a subscribed visitor who reloaded mid-video.
  player.on('loadedmetadata', updateWatchProgressUI);

  // Fire video_complete when the user reaches 80% of the video
  let videoCompleteTracked = false;
  player.on('timeupdate', () => {
    const dur = player.duration;
    const t = player.currentTime;

    const now = performance.now();
    const delta = t - lastTick;
    const played = isPlaybackStep(delta, now);
    lastTick = t;
    lastTickAt = now;
    if (played) {
      watchedSeconds += delta;
      if (t > furthestSeconds) furthestSeconds = t;
    } else if (t > furthestSeconds + SEEK_CLAMP_BUFFER) {
      // A skip ahead the 'seeking' clamp didn't catch. Some browsers (Safari) can
      // deliver a tick at the new position before 'seeking' fires, which used to count
      // the jump as progress. Only real playback moves furthest, and this snaps back.
      player.currentTime = furthestSeconds;
      return;
    }
    if (watchedSeconds - lastSaved >= 2) { lastSaved = watchedSeconds; saveWatch(); }
    updateWatchProgressUI();

    if (!videoCompleteTracked && dur > 0 && t >= dur * 0.8) {
      videoCompleteTracked = true;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'video_complete' });
    }
  });
</script>
