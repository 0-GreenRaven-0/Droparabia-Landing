</style>


<style>
  /* ══════════════ LAYOUT ══════════════ */
  .wrap {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 20px;
  }


  .hero {
    position: relative;
    background: var(--da-bg);
    text-align: center;
    padding: 48px 0;
    overflow: hidden;
  }

  .corner-hex-tl {
    position: absolute;
    /* Pushed past the page's own edge rather than flush with it, so the cluster reads
       as continuing in from outside the viewport instead of starting neatly at the
       corner. .hero clips it at the true page edge (it sits flush at 0,0 itself),
       which is what actually produces the cut-off-by-the-page look. */
    top: clamp(-90px, -8vw, -60px);
    left: clamp(-90px, -8vw, -60px);
    /* Bigger than before: the curve needs room, and whole (uncut) tiles need more
       space than a cut grid did to still read as a cluster rather than a sliver. */
    width: clamp(280px, 32vw, 440px);
    height: clamp(220px, 25vw, 340px);
    pointer-events: none;
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  /* inline-flex, not flex: the hero is already text-align:center, so the lockup
     centres itself without needing a width or justify-content. */
  .hero-brand {
    display: inline-flex;
    align-items: center;
    gap: clamp(10px, 1.6vw, 20px);
    text-decoration: none;
    margin-bottom: clamp(16px, 2.4vw, 28px);
  }

  .hero-brand-logo {
    width: clamp(46px, 6vw, 72px);
    height: auto;
    object-fit: contain;
  }

  .hero-brand-name {
    font-family: var(--font-brand);
    font-size: clamp(1.7rem, 4.6vw, 2.8rem);
    line-height: 1;
    color: #000;
    letter-spacing: 0.01em;
  }

  /* Tiny and red, sitting under the logo. Wider than a typical caption on purpose. */
  .hero-disclaimer {
    max-width: 900px;
    margin: 6px auto 0;
    padding: 0 var(--sp-gutter) 24px;
    font-size: 0.68rem;
    line-height: 1.4;
    font-weight: 600;
    color: #dc2626;
    text-align: center;
    text-wrap: balance;
  }

  .headline {
    font-family: var(--font-brand);
    font-size: clamp(1.6rem, 4.4vw, 2.6rem);
    /* IBrand is declared at normal weight only, so anything heavier would be a
       synthesised bold rather than a real one. */
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
