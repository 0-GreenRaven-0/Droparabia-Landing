---
import Layout from '../layouts/Layout.astro';
import HexBackground from '../components/HexBackground.astro';
import { siInstagram, siThreads, siYoutube } from 'simple-icons';
---

<Layout>

  <!-- ═══════════ 1. HEADLINE + GATED VSL ═══════════ -->
  <section class="hero">
    <!-- One staggered hex column hugging each edge. cutCorner is off on both: that
         diagonal was designed to trim a corner off a full-width grid, and on a narrow
         edge strip it erases nearly the whole strip. -->
    <HexBackground id="hex-bg-hero-left" cutCorner={false} fadeTop={true} fadeHeight={1} revealColumns={1} revealSide="left" alignTopEdge={true} />
    <HexBackground id="hex-bg-hero-right" cutCorner={false} fadeTop={true} fadeHeight={1} revealColumns={1} revealSide="right" alignTopEdge={true} />
    <!-- Top edge row. fadeTop must stay off here — it drops exactly the rows this
         instance exists to draw. -->
    <HexBackground id="hex-bg-hero-top" cutCorner={false} fadeTop={false} revealRows={1} revealVSide="top" alignTopEdge={true} />

    <a href="/" class="corner-brand" aria-label="Droparabia">
      <img src="/Droparabia.png" alt="" class="corner-brand-logo" width="40" height="40" />
      <span class="corner-brand-name">Droparabia</span>
    </a>

    <div class="wrap">

      <!-- Fallback content (no-JS / first paint) — a synchronous inline script right
           below swaps this for one of the three A/B/C hook variants before the browser
           has painted much of anything else on the page. -->
      <h1 class="headline" id="headline">
        You'll never burn your budget on Inventory, shipping fees or beginners mistakes ever again with <span class="grad-text">this system</span>
      </h1>

      <script is:inline>
        (function () {
          var variants = {
            pain: 'Stop wasting your <span class="mark">savings</span> on Inventory, shipping fees and beginners mistakes',
            mechanism: 'Build your <span class="grad-text">high-earning e-com business</span> without spending <span class="mark">a dollar</span> on Inventory',
            fomo: 'How <span class="mark">+800 Lebanese</span> ditched traditional e-com &amp; built a <span class="grad-text">high-earning online store</span>',
          };
          // sessionStorage, not localStorage: a fresh browser session gets a new random
          // pick each time, but stays on the same hook while navigating within that
          // session (so it doesn't flip mid-visit, e.g. going back from /survey).
          var STORAGE_KEY = 'da_headline_variant';
          var variant = null;
          try { variant = sessionStorage.getItem(STORAGE_KEY); } catch (_) {}
          if (!variant || !variants[variant]) {
            var keys = Object.keys(variants);
            variant = keys[Math.floor(Math.random() * keys.length)];
            try { sessionStorage.setItem(STORAGE_KEY, variant); } catch (_) {}
          }
          var el = document.getElementById('headline');
          if (el) el.innerHTML = variants[variant];
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'headline_variant_assigned', headline_variant: variant });
        })();
      </script>

      <p class="headline-warning">THIS HAS NOTHING TO DO WITH DROPSHIPPING OR TRADITIONAL E-COMMERCE</p>

      <!-- Social proof bar: active user count + Trustpilot rating -->
      <div class="social-proof">
        <span class="sp-users">Proven system used by +700 Lebanese</span>
        <span class="sp-divider"></span>
        <div class="sp-trust">
          <img src="/Trustpilot_Logo_(2022).svg.png" alt="Trustpilot" class="sp-tp-logo" width="300" height="74" />
          <div class="sp-stars">
            <svg viewBox="0 2 23 23.3" class="sp-star"><path fill="#00b67a" d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z"/></svg>
            <svg viewBox="0 2 23 23.3" class="sp-star"><path fill="#00b67a" d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z"/></svg>
            <svg viewBox="0 2 23 23.3" class="sp-star"><path fill="#00b67a" d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z"/></svg>
            <svg viewBox="0 2 23 23.3" class="sp-star"><path fill="#00b67a" d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z"/></svg>
            <svg viewBox="0 2 23 23.3" class="sp-star"><path fill="#c8c8c8" d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z"/></svg>
          </div>
        </div>
      </div>

      <!-- VSL — plain Plyr play button; subscription is gated behind the play click itself -->
      <div class="vsl-wrapper">
        <video id="vsl-player" playsinline preload="metadata">
          <source src="/vsl.mp4" type="video/mp4" />
        </video>
      </div>

      <!-- Watch-progress bar — hidden until they subscribe, then tracks how far into
           the VSL they've gotten. Booking is gated on reaching 40%, so this is the
           visible half of that gate; see the Plyr script below for the other half. -->
      <div class="vsl-progress-wrap" id="vsl-progress-wrap" style="display:none">
        <div class="vsl-progress-track">
          <div class="vsl-progress-marker" style="left:40%"></div>
          <div class="vsl-progress-bar" id="vsl-progress-bar" style="width:0%"></div>
        </div>
        <span class="vsl-progress-label" id="vsl-progress-label">0% watched</span>
      </div>

      <!-- Hidden until the subscribe modal succeeds (or the visitor is already
           subscribed this session) — see the "unlockVideo"-equivalent block in the
           Plyr script below. Starts locked (grey, inert) until 40% of the VSL has
           been watched. -->
      <p class="book-cta-gate" id="book-cta-gate" style="display:none">Watch at least 40% of the tutorial to book a FREE discovery call</p>
      <a href="/survey" class="book-cta is-locked" id="book-cta" style="display:none" aria-disabled="true">
        Book a FREE strategy call
        <span class="book-cta-sub">Let's get your business started</span>
      </a>

    </div>
  </section>

  <!-- ═══════════ 2. CASE STUDIES ═══════════ -->
  <section class="proof-section">
    <h2 class="section-heading">
      <svg class="heading-arrow" viewBox="0 0 24 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2 L12 22 M4 15 L12 24 L20 15" stroke="url(#arrowGrad3)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><defs><linearGradient id="arrowGrad3" x1="12" y1="2" x2="12" y2="24" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#06a2d1"/><stop offset="100%" stop-color="#2745ff"/></linearGradient></defs></svg>
      From our latest weekly case studies
      <svg class="heading-arrow" viewBox="0 0 24 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2 L12 22 M4 15 L12 24 L20 15" stroke="url(#arrowGrad4)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><defs><linearGradient id="arrowGrad4" x1="12" y1="2" x2="12" y2="24" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#06a2d1"/><stop offset="100%" stop-color="#2745ff"/></linearGradient></defs></svg>
    </h2>

    <!-- Carousel ported verbatim from droparabia-official's reviews page
         (CaseStudyCarousels.astro): same slide set with the newest testimonials first,
         same gradient nav buttons straddling the container edges. -->
    <div class="carousel-container">
      <div class="swiper testimonials-swiper" id="cs-swiper-1">
        <div class="swiper-wrapper">
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/droparabia/testimonial-1.png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/droparabia/testimonial-2.png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/droparabia/testimonial-3.png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/droparabia/testimonial-4.png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/4.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/5.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/2.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/6.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/1.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/2.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/3.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo.png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(1).png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
        </div>
      </div>

      <button type="button" class="case-carousel-nav case-carousel-prev" aria-label="Previous">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <button type="button" class="case-carousel-nav case-carousel-next" aria-label="Next">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
    </div>
  </section>

  <!-- ═══════════ FOOTER ═══════════ -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo-link">
          <img src="/Droparabia.png" alt="Droparabia logo" class="footer-logo-img" />
          <span class="footer-logo-name">Droparabia</span>
        </a>
      </div>

      <div class="footer-links">
        <p class="footer-links-label">Legal</p>
        <div class="footer-compliance">
          <a href="/privacy-policy" class="footer-compliance-link">Privacy Policy</a>
          <a href="/terms" class="footer-compliance-link">Terms &amp; Conditions</a>
        </div>
      </div>

      <div class="footer-links">
        <p class="footer-links-label">Follow us</p>
        <div class="footer-socials">
          <a href="https://www.instagram.com/mjbusinessofficial?igsh=Mm5jdmFjMTljbm0x" target="_blank" rel="noopener" class="footer-social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d={siInstagram.path}/></svg>
          </a>
          <a href="https://www.threads.com/@mjbusinessofficial" target="_blank" rel="noopener" class="footer-social-link" aria-label="Threads">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d={siThreads.path}/></svg>
          </a>
          <a href="https://www.youtube.com/@MJ.biznes" target="_blank" rel="noopener" class="footer-social-link" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d={siYoutube.path}/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 Droparabia. All rights reserved.</p>
    </div>
  </footer>

  <!-- VSL Subscription Modal — opens when Plyr's play button is clicked while unsubscribed -->
  <div id="vsl-modal" class="vsl-modal-overlay" aria-hidden="true">
    <div class="vsl-modal-box" role="dialog" aria-modal="true" aria-labelledby="vsl-modal-title">
      <button class="vsl-modal-close" id="vsl-modal-close" aria-label="Close">&times;</button>
      <div class="vsl-modal-head">
        <h3 class="vsl-modal-title" id="vsl-modal-title">
          One small step needed!<br /><span class="vsl-modal-title-sub">Subscribe to unlock this Tutorial for FREE!</span>
        </h3>
        <p class="vsl-modal-warning">This Tutorial Might be taken down soon!</p>
      </div>
      <div id="vsl-error-msg" class="brevo-alert brevo-alert--error" style="display:none">Could not subscribe. Please try again.</div>
      <div id="vsl-success-msg" class="brevo-alert brevo-alert--success" style="display:none">Subscribed! Starting your video...</div>
      <form id="vsl-modal-form" class="vsl-modal-form" method="POST" action="/api/subscribe" data-type="subscription">
        <div class="field-line">
          <span class="field-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <input type="text" name="FIRSTNAME" placeholder="First and Last Name" required autocomplete="name" />
        </div>
        <div class="field-line">
          <span class="field-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <!-- type="email", not "text": as a plain text field Chrome's autofill treated
               this as a generic box and filled it with the surname, which Brevo then
               rejected as an invalid email. Also gives an email keyboard on mobile. -->
          <input type="email" name="EMAIL" placeholder="Your Best Email" required autocomplete="email" inputmode="email" />
        </div>
        <div class="field-line">
          <span class="field-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.31 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 5.45 5.45l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <input type="hidden" name="SMS__COUNTRY_CODE" value="+961" />
          <span class="sms-country-fixed">+961</span>
          <span class="sms-divider">|</span>
          <input type="tel" name="SMS" placeholder="WhatsApp Number" required autocomplete="tel" />
        </div>
        <p id="vsl-modal-email-err" class="vsl-inline-err" style="display:none">Please enter a valid email address</p>
        <p id="vsl-modal-phone-err" class="vsl-inline-err" style="display:none">Please enter a valid Lebanese number (e.g. 70 123 456)</p>
        <button type="submit" class="vsl-inline-btn">Start Watching!</button>
        <p class="vsl-inline-consent">By subscribing, you agree to receive invitation to future events and offers from Droparabia</p>
        <input type="text" name="email_address_check" value="" style="display:none">
        <input type="hidden" name="locale" value="en">
      </form>
    </div>
  </div>

</Layout>


<!-- Global: palette, font lock-down, and Plyr internals (Plyr builds its DOM at runtime) -->
<style is:global>
  :root {
    /* Borrowed from droparabia-official */
    --da-primary:    #001eff;
    --da-blue:       #2745ff;
    --da-blue-deep:  #001a80;
    --da-navy:       #000c66;
    --da-cyan:       #06a2d1;
    --da-purple:     #7200b0;
    --da-bg:         #f0f0f0;
    --da-surface:    #ffffff;
    --da-line:       #dcdbd9;
    --da-ink:        #0b1230;
    --da-ink-soft:   #4a5170;
    --da-ink-mute:   #7b8098;
    --da-cta:        #16a34a;
    --da-cta-light:  #22c55e;
  }

  body {
    background: var(--da-bg) !important;
    color: var(--da-ink);
  }

  /* Nothing on this page renders in anything but Inter or IBrand. */
  .plyr,
  .plyr *,
  .plyr__control,
  .plyr__tooltip,
  .plyr__menu,
  .plyr__menu * {
    font-family: var(--font-body) !important;
  }

  /* ─── Plyr skin ─── */
  .vsl-wrapper {
    --plyr-color-main: var(--da-blue);
    --plyr-control-icon-size: 28px;
    --plyr-font-family: var(--font-body);
  }

  .vsl-wrapper .plyr,
  .vsl-wrapper .plyr__video-wrapper {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .vsl-wrapper video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .vsl-wrapper .plyr__control--overlaid {
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    margin: 0 !important;
  }
</style>


<style>
  /* ══════════════ LAYOUT ══════════════ */
  .wrap {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ══════════════ 1. HEADLINE + VSL ══════════════ */
  /* position:relative anchors HexBackground's absolutely-positioned canvas to this
     section; the .wrap below is lifted above it with its own stacking context. */
  .hero {
    position: relative;
    background: var(--da-bg);
    text-align: center;
    padding: 76px 0 48px;
    overflow: hidden;
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  /* Pinned to the hero's top-left corner, above the hex canvases. Absolute so it
     doesn't push the centered headline block down. */
  .corner-brand {
    position: absolute;
    top: 20px;
    left: 24px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }

  .corner-brand-logo {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .corner-brand-name {
    font-family: var(--font-brand);
    font-size: 1.5rem;
    line-height: 1;
    color: #000;
    letter-spacing: 0.01em;
  }

  .headline {
    font-size: clamp(1.6rem, 4.4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--da-ink);
    max-width: 34ch;
    margin: 0 auto 14px;
    text-wrap: balance;
  }

  .headline-warning {
    font-size: clamp(0.7rem, 1.5vw, 0.85rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    color: #dc2626;
    text-transform: uppercase;
    margin: 0 auto 18px;
  }

  /* ─── SOCIAL PROOF BAR ─── */
  .social-proof {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 auto 24px;
  }

  .sp-users {
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--da-ink);
    line-height: 1;
  }

  .sp-divider {
    width: 1px;
    height: 24px;
    background: var(--da-line);
  }

  .sp-trust {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .sp-tp-logo {
    height: 28px;
    width: auto;
  }

  .sp-stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  /* viewBox is the star path's own bounding box (x 0-23, y 2-25.3) rather than the
     0 0 24 24 it shipped with — that clipped the lower points and pushed the shape
     below the box's centre, which is what knocked it out of line with the text. */
  .sp-star {
    width: 23px;
    height: 23px;
    display: block;
  }

  .grad-text {
    background: linear-gradient(90deg, var(--da-cyan), var(--da-blue), var(--da-cyan));
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    animation: grad-pan 4s linear infinite;
  }

  @keyframes grad-pan { to { background-position: 200% center; } }

  .mark {
    position: relative;
    white-space: nowrap;
  }

  .mark::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.16em;
    background: var(--da-primary);
    opacity: 0.22;
    border-radius: 2px;
  }

  /* ─── VSL ─── */
  .vsl-wrapper {
    max-width: 660px;
    width: 100%;
    margin: 0 auto 28px;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #000;
    position: relative;
    box-shadow:
      0 0 0 4px var(--da-blue),
      0 24px 60px rgba(0, 30, 255, 0.20);
  }

  /* Book-a-call CTA, revealed the moment the VSL unlocks (see the Plyr script). */
  .book-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    max-width: 420px;
    width: 100%;
    margin: 22px auto 0;
    padding: 15px 20px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--da-cta) 0%, var(--da-cta-light) 100%);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.10), 0 2px 16px rgba(22, 163, 74, 0.35);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .book-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15), 0 6px 32px rgba(22, 163, 74, 0.50);
  }

  .book-cta-sub {
    font-size: 0.78rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Watch-progress bar, shown once subscribed. */
  .vsl-progress-wrap {
    max-width: 420px;
    width: 100%;
    margin: 18px auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .vsl-progress-track {
    position: relative;
    width: 100%;
    height: 8px;
    border-radius: 999px;
    background: var(--da-line);
    overflow: hidden;
  }

  /* Tick at the 40% unlock point, so the bar reads as "progress toward a goal"
     rather than a plain loading indicator. */
  .vsl-progress-marker {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0.7);
    z-index: 1;
  }

  .vsl-progress-bar {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--da-cta) 0%, var(--da-cta-light) 100%);
    transition: width 0.3s ease;
  }

  .vsl-progress-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--da-ink-mute);
  }

  /* Gate message, shown above the CTA only once subscribed and only while locked. */
  .book-cta-gate {
    max-width: 420px;
    width: 100%;
    margin: 16px auto 0;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--da-ink);
  }

  /* Locked state: same CTA, just inert and greyed out until 40% is reached. */
  .book-cta.is-locked {
    margin-top: 10px;
    background: var(--da-line);
    color: var(--da-ink-mute);
    box-shadow: none;
    cursor: not-allowed;
    pointer-events: none;
  }

  .book-cta.is-locked:hover {
    transform: none;
    box-shadow: none;
  }

  .book-cta.is-locked .book-cta-sub {
    color: var(--da-ink-mute);
  }

  /* ─── VSL SUBSCRIPTION MODAL ─── */
  .vsl-modal-overlay {
    position: fixed;
    inset: 0;
    /* html/body carry overflow-x: hidden, and on mobile that lets a fixed overlay
       stretch to the page's scrollable width instead of the viewport whenever
       something on the page overflows sideways — which pushed this modal and its
       inputs off the right edge of the screen. Pinning the width to the viewport
       keeps the box centred however wide the document gets; min() so desktop,
       where 100% already excludes the scrollbar, is left alone. */
    width: min(100vw, 100%);
    background: rgba(0, 0, 0, 0.72);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s;
  }

  .vsl-modal-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .vsl-modal-box {
    background: var(--da-surface);
    border-radius: 20px;
    padding: 40px 36px 32px;
    max-width: 460px;
    width: 100%;
    position: relative;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
    transform: translateY(14px) scale(0.97);
    transition: transform 0.25s;
    box-sizing: border-box;
    text-align: left;
  }

  .vsl-modal-overlay.is-open .vsl-modal-box {
    transform: translateY(0) scale(1);
  }

  .vsl-modal-close {
    position: absolute;
    top: 14px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: var(--da-bg);
    color: var(--da-ink-mute);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, color 0.15s;
  }

  .vsl-modal-close:hover { background: var(--da-line); color: var(--da-ink); }

  .vsl-modal-head {
    text-align: center;
    margin-bottom: 24px;
  }

  .vsl-modal-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--da-ink);
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }

  .vsl-modal-title-sub {
    font-size: 1rem;
    font-weight: 700;
  }

  .vsl-modal-warning {
    color: #dc2626;
    font-size: 0.78rem;
    font-weight: 500;
    margin-top: 6px;
  }

  .brevo-alert--success,
  .brevo-alert--error {
