  /* ══════════════ 2. CASE STUDIES ══════════════ */
  .proof-section {
    /* Top is deliberate, not the scale: it pairs with the hero's bottom to keep the
       carousel tight under the video while the progress bar and CTA are hidden. */
    padding: 52px 0 0;
    background: var(--da-bg);
  }

  .proof-disclaimer {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--sp-gutter);
    font-size: 0.68rem;
    line-height: 1.4;
    font-weight: 600;
    color: #dc2626;
    text-align: center;
    text-wrap: balance;
  }

  .section-heading {
    font-family: var(--font-brand);
    font-size: clamp(1.7rem, 4.8vw, 2.9rem);
    /* IBrand ships at normal weight only — 800 would be a synthesised bold. */
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--da-navy);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: var(--sp-block);
    padding: 0 var(--sp-gutter);
  }

  .heading-arrow {
    width: 28px;
    height: 36px;
    flex-shrink: 0;
    /* Both bob in step rather than staggered: they're a matched pair pointing at the
       same line, so the symmetry is the point. */
    animation: arrow-bob 1.5s ease-in-out infinite;
  }

  @keyframes arrow-bob {
    0%, 100% { transform: translateY(-15%); }
    50%      { transform: translateY(15%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .heading-arrow { animation: none; }
  }

  .carousel-container {
    position: relative;
    max-width: 1152px;
    margin: var(--sp-block) auto 0;
    padding: 0 var(--sp-gutter);
  }

  .testimonials-swiper { overflow: hidden; }

  .swiper-slide {
    overflow: hidden;
    border-radius: 16px;
    box-shadow:
      0 18px 38px -14px rgba(0, 0, 0, 0.30),
      0 5px 14px -8px rgba(0, 0, 0, 0.18);
  }

  .swiper-slide img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Gradient pills straddling the container edges, per the official reviews page. */
  .case-carousel-nav {
    position: absolute;
    top: 50%;
    z-index: 10;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: linear-gradient(135deg, #2745ff, #001eff 45%, #000c66);
    box-shadow: 0 6px 16px -6px rgba(0, 30, 255, 0.35);
    transition: transform 0.15s ease-out;
  }

  .case-carousel-prev {
    left: 0;
    transform: translate(-50%, -50%);
  }

  .case-carousel-next {
    right: 0;
    transform: translate(50%, -50%);
  }

  .case-carousel-prev:hover { transform: translate(-50%, -50%) scale(1.1); }
  .case-carousel-next:hover { transform: translate(50%, -50%) scale(1.1); }

  /* ══════════════ 2b. VIDEO WINS ═════════════ */
  .vt-section {
    background: var(--da-bg);
    padding: var(--sp-section) var(--sp-gutter) 0;
    text-align: center;
  }

  .vt-heading {
    font-family: var(--font-brand);
    font-size: clamp(1.7rem, 4.4vw, 2.6rem);
    font-weight: 400;
    color: var(--da-ink);
    margin-bottom: var(--sp-block);
  }

  .vt-section, .vt-pill, .vt-badge, .vt-watch, .vt-caption {
