    --da-cta:        #001eff;
    --da-cta-light:  #2745ff;

    /* ── Spacing scale ──
       section: the air above and below a section
       block:   a heading or lead-in away from the content it introduces
       gutter:  the page's left/right padding
       Each interpolates between its phone value and its desktop value on its own,
       so nothing here needs a media query to restate it. */
    /* The low end is what a phone gets: 14vw is only 55px at 390px wide, so the
       minimum is the number that actually applies there. Keeping it at the desktop
       scale left a screen that was mostly empty. */
    --sp-section: clamp(68px, 14vw, 176px);
    --sp-block:   clamp(20px, 2.8vw, 32px);
