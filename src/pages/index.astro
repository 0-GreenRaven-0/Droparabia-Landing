    line-height: 1.5;
    color: var(--da-ink-soft);
    max-width: 860px;
    margin: 0 auto 22px;
    text-wrap: balance;
  }

  .headline-sub-red {
    font-weight: 700;
    color: #dc2626;
  }

  /* The red line hands most of its space to the line under it, so the two read as one
     statement rather than two stacked paragraphs. */
  .headline-sub.headline-sub--lead {
    margin-bottom: 5px;
  }

  /* The supporting line sits a step below the red one: narrower, lighter and smaller,
     which is what keeps the pair from eating the screen above the video on a phone. */
  .headline-sub.headline-sub--detail {
    /* No cap and no balancing: it uses the container's full width and breaks wherever
       it runs out of room, instead of being held to a narrow column and split into
       short, even lines. */
    max-width: none;
    text-wrap: initial;
    font-size: clamp(0.8rem, 1.3vw, 0.95rem);
  }

  .headline-sub strong {
    font-weight: 700;
    color: var(--da-ink);
  }

  .grad-text {
    background: linear-gradient(90deg, var(--da-cyan), var(--da-blue), var(--da-cyan));
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    animation: grad-pan 4s linear infinite;
  }

  @keyframes grad-pan { to { background-position: 200% center; } }

  .mark {
    position: relative;
    white-space: nowrap;
  }

  .mark::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
