  }

  .brevo-alert--error {
    background: rgba(220, 38, 38, 0.10);
    border: 1px solid rgba(220, 38, 38, 0.35);
    color: #dc2626;
  }

  .vsl-modal-form {
    display: grid;
    gap: 10px;
  }

  .field-line {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--da-surface);
    border: 1px solid var(--da-line);
    border-radius: 10px;
    padding: 0 12px;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .field-line:focus-within {
    border-color: var(--da-primary);
    box-shadow: 0 0 0 3px rgba(0, 30, 255, 0.12);
  }

  .field-icon {
    display: flex;
    color: var(--da-ink-mute);
    flex-shrink: 0;
  }

  .field-line input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    padding: 12px 0;
    font-size: 0.95rem;
    color: var(--da-ink);
  }

  .field-line input::placeholder { color: var(--da-ink-mute); }

  .sms-country-fixed {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--da-ink-soft);
    flex-shrink: 0;
  }

  .sms-divider {
    color: var(--da-line);
    flex-shrink: 0;
  }

  .vsl-inline-err {
    font-size: 0.78rem;
    color: #dc2626;
    margin-top: -4px;
  }

  .vsl-inline-btn {
    width: 100%;
    border: none;
    border-radius: 12px;
    padding: 14px 20px;
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, var(--da-cta) 0%, var(--da-cta-light) 100%);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.10), 0 2px 16px rgba(22, 163, 74, 0.35);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .vsl-inline-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15), 0 6px 32px rgba(22, 163, 74, 0.50);
  }

  .vsl-inline-btn:active:not(:disabled) { transform: translateY(2px); }

  .vsl-inline-btn:disabled { opacity: 0.7; cursor: default; }

  .vsl-inline-consent {
    font-size: 0.7rem;
    color: var(--da-ink-mute);
    text-align: center;
    margin-top: 4px;
    line-height: 1.4;
  }

  /* ══════════════ 2. CASE STUDIES ══════════════ */
  .proof-section {
    padding: 52px 0 60px;
    background: var(--da-bg);
  }

  .section-heading {
    font-size: clamp(1.35rem, 3.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--da-navy);
    text-align: center;
    display: flex;
