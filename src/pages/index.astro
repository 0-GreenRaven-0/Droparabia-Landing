---
import Layout from '../layouts/Layout.astro';
import { siInstagram, siThreads, siYoutube } from 'simple-icons';
import PhoneCountrySelect from '../components/PhoneCountrySelect.astro';
import EmailTypo from '../components/EmailTypo.astro';
import HexBackground from '../components/HexBackground.astro';

// Trustpilot's own rating blocks (512x96) from /public. Only the 5 and 4.5 star blocks
// exist, which covers every review below; a lower-rated review needs its own asset
// rather than the nearest one, so the rating shown stays the rating given.
const STAR_BLOCKS: Record<string, string> = { '5': '/stars-5.svg', '4.5': '/stars-4.5.svg' };

// Split into words in the markup below, so each word carries the gradient on its own.
const HEADLINE = 'How 800+ Lebanese launched their e-com businesses without owning a single product';

// Real Trustpilot reviews, copied verbatim (newest first). Dates are the review dates
// shown on Trustpilot; every one of these is 5 stars.
const trustpilotReviews = [
  { name: 'Michel Hsan', date: 'Sep 27, 2026', stars: 5, text: 'This application significantly helps reduce shipping costs by allowing you to source the product without having to handle the shipping process yourself.' },
  { name: 'geo kazan', date: 'Aug 29, 2026', stars: 5, text: 'The system works if you stay consistent and put enough effort' },
  { name: 'Karim Sabeh', date: 'Jul 27, 2026', stars: 5, text: 'I use it personally it is beginner friendly and you can make a living from it' },
  { name: 'Karim Moghnieh', date: 'Jun 18, 2026', stars: 5, text: 'Professional, reliable, and knowledgeable team. Helped spark out my career in freelancing!' },
  { name: 'Hhh Mmm', date: 'Jun 17, 2026', stars: 5, text: 'One of the best programs\nIt gave me a real opportunity to grow and to be financially independent\nVery professional team thank you for this helpful and easy program' },
  { name: 'MD Tech', date: 'Jun 16, 2026', stars: 5, text: "It's a very successful system and provides professional courses and continuous feedback and support for students. High quality products, excellent storage and packaging and smooth money transactions.\n\nVery recommended for people who want to start a small e-com business with a small capitol" },
  { name: 'Tarek', date: 'May 26, 2026', stars: 5, text: 'Smooth experience using this app. The platform is easy to use and order processing is simple. Definitely a useful app for anyone running a dropshipping business.' },
];
---

<Layout>

  <EmailTypo />


  <!-- ═══════════ 1. HEADLINE + GATED VSL ═══════════ -->
  <section class="hero">
    <div class="corner-hex-tl">
      <HexBackground id="corner-hex-tl" cutCorner={false} wholeOnly scale={0.55} roundFarCorner farCornerRadius={0.85} />
    </div>

    <div class="wrap">

      <!-- Stands where the header bar was. Same lockup, centred and much larger, so the
           page opens on the brand instead of a nav strip. -->
      <a href="/" class="hero-brand" aria-label="Droparabia">
        <img src="/Droparabia.png" alt="" class="hero-brand-logo" width="110" height="110" />
        <span class="hero-brand-name">Droparabia</span>
      </a>

      <p class="hero-disclaimer">Droparabia provides tools and guidance for building and running an e-commerce business and not a "get-rich-quick" scheme</p>

      <!-- One span per word: the gradient is clipped to each word's own height, so every
           word runs black into blue. Across the whole block it would instead stretch over
           both lines, painting the first line black and the second line blue. -->
      <h1 class="headline">{HEADLINE.split(' ').map((word, i) => (<>{i > 0 && ' '}<span class="headline-word">{word}</span></>))}</h1>

      <script is:inline>
        // One hook now, so nothing is being split-tested and the headline ships in the
        // HTML rather than being written in after paint. The variant is still recorded,
        // because the sheet's Headline column and the GTM event read it, and a blank
        // there would look like tracking had broken rather than like a choice.
        (function () {
          try { sessionStorage.setItem('da_headline_variant', 'fomo'); } catch (_) {}
        })();
      </script>

      <p class="headline-sub">Using an <strong>AI-powered platform</strong> that finds in-demand products for the Lebanese market and <strong>delivers them to your customer's doorstep</strong></p>

      <ul class="stat-strip">
        <li><span class="stat-figure">$300K-$400K</span><span class="stat-label">generated in revenue by all sellers</span></li>
        <li><span class="stat-figure">+800</span><span class="stat-label">sellers and brand owners</span></li>
        <li><span class="stat-figure">90%</span><span class="stat-label">delivery success rate in COD</span></li>
        <li><span class="stat-figure">Official Shopify Partner</span></li>
      </ul>

      <!-- VSL — plain Plyr play button; subscription is gated behind the play click itself.
           The stage exists so the hex grid sits behind the player alone rather than the
           whole hero; its padding is what lets the grid show around the video instead of
           being completely covered by it. -->
      <div class="vsl-stage">
        <HexBackground id="vsl-hex" cutCorner={false} wholeOnly scale={0.62} dropTopCorners alignTopEdge />

        <div class="vsl-wrapper">
          <video id="vsl-player" playsinline preload="metadata">
            <source src="/vsl.mp4" type="video/mp4" />
          </video>
        </div>
      </div>

      <!-- Watch-progress bar — hidden until they subscribe, then tracks how far into
           the VSL they've gotten. Booking is gated on reaching 40%, so this is the
           visible half of that gate; see the Plyr script below for the other half. -->
      <div class="vsl-progress-wrap" id="vsl-progress-wrap" style="display:none">
        <div class="vsl-progress-track">
          <div class="vsl-progress-marker" style="left:40%"></div>
          <div class="vsl-progress-bar" id="vsl-progress-bar" style="width:0%"></div>
        </div>
        <span class="vsl-progress-label" id="vsl-progress-label">0% watched</span>
      </div>

      <!-- Hidden until the subscribe modal succeeds (or the visitor is already
           subscribed this session) — see the "unlockVideo"-equivalent block in the
           Plyr script below. Starts locked (grey, inert) until 40% of the VSL has
           been watched. -->
      <p class="book-cta-gate" id="book-cta-gate" style="display:none">Watch at least 40% of the tutorial to see if you qualify to access Droparabia</p>
      <a href="/survey" class="book-cta is-locked" id="book-cta" style="display:none" aria-disabled="true">
        See if you qualify
        <!-- Replaced with the live count from /api/spots (17 per week, resets Monday 12 AM Beirut time) -->
        <span class="book-cta-sub" id="book-cta-spots">Limited spots are available this week</span>
      </a>

    </div>
  </section>

  <!-- ═══════════ 2. CASE STUDIES ═══════════ -->
  <section class="proof-section" id="case-studies">
    <h2 class="section-heading">
      <svg class="heading-arrow" viewBox="0 0 24 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2 L12 22 M4 15 L12 24 L20 15" stroke="url(#arrowGrad3)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><defs><linearGradient id="arrowGrad3" x1="12" y1="2" x2="12" y2="24" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#06a2d1"/><stop offset="100%" stop-color="#2745ff"/></linearGradient></defs></svg>
      Weekly latest results
      <svg class="heading-arrow" viewBox="0 0 24 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2 L12 22 M4 15 L12 24 L20 15" stroke="url(#arrowGrad4)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><defs><linearGradient id="arrowGrad4" x1="12" y1="2" x2="12" y2="24" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#06a2d1"/><stop offset="100%" stop-color="#2745ff"/></linearGradient></defs></svg>
    </h2>

    <!-- Sits with the results it qualifies, not in the footer: the claim and the
         caveat have to be read together. -->
    <p class="proof-disclaimer">Results vary and depend on each person's effort and circumstances. No earnings are guaranteed. Any results shared are individual experiences, not typical outcomes.</p>

    <!-- Carousel ported verbatim from droparabia-official's reviews page
         (CaseStudyCarousels.astro): same slide set with the newest testimonials first,
         same gradient nav buttons straddling the container edges. -->
    <div class="carousel-container">
      <div class="swiper testimonials-swiper" id="cs-swiper-1">
        <div class="swiper-wrapper">
          <!-- Newest first. Served straight from /public, unlike the slides below
               which come through ImageKit's resizing CDN. -->
          <div class="swiper-slide"><img src="/Case%20studies/Instagram%20story%20-%201.png" alt="Case Study" loading="lazy" width="1080" height="1920" /></div>
          <div class="swiper-slide"><img src="/Case%20studies/Instagram%20story%20-%202.png" alt="Case Study" loading="lazy" width="1080" height="1920" /></div>
          <div class="swiper-slide"><img src="/Case%20studies/Instagram%20story%20-%203.png" alt="Case Study" loading="lazy" width="1080" height="1920" /></div>
          <div class="swiper-slide"><img src="/Case%20studies/Instagram%20story%20-%204.png" alt="Case Study" loading="lazy" width="1080" height="1920" /></div>
          <div class="swiper-slide"><img src="/Case%20studies/Instagram%20story%20-%205.png" alt="Case Study" loading="lazy" width="1080" height="1920" /></div>
          <div class="swiper-slide"><img src="/Case%20studies/Instagram%20story%20-%206.png" alt="Case Study" loading="lazy" width="1080" height="1920" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/droparabia/testimonial-1.png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/droparabia/testimonial-2.png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/droparabia/testimonial-3.png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/droparabia/testimonial-4.png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/4.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/5.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/2.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/6.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/1.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/2.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Case%20Studies/3.png?tr=w-900,q-70,f-webp" alt="Case Study" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo.png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
          <div class="swiper-slide"><img src="https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(1).png?tr=w-900,q-70,f-webp" alt="Testimonial" loading="lazy" /></div>
        </div>
      </div>

      <button type="button" class="case-carousel-nav case-carousel-prev" aria-label="Previous">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <button type="button" class="case-carousel-nav case-carousel-next" aria-label="Next">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
    </div>
  </section>


  <!-- ═══════════ 2b. VIDEO WINS ═══════════ -->
  <!-- Light section, matching the rest of the page — no separate dark palette.
       Checklist bullets and two of the three names are placeholders; replace them
       before this ships. Plain grid, not a carousel: with exactly three cards there's
       nothing to page through, so no nav buttons either. -->
  <section class="vt-section" aria-labelledby="vt-heading">
    <h2 class="vt-heading" id="vt-heading">Recent Success stories</h2>

    <div class="vt-grid">
      <div class="vt-card-outer">
        <span class="vt-pill">Karim — Accounting</span>
        <a class="vt-card" href="https://youtu.be/pmKmT072hV4" target="_blank" rel="noopener" aria-label="Watch on YouTube">
          <img src="/karim.webp" alt="" class="vt-thumb" loading="lazy" width="480" height="270" />
          <span class="vt-title">How Karim Made His First $8,297 In 90 Days In Lebanon</span>
          <span class="vt-play"><svg viewBox="0 0 68 48" aria-hidden="true"><path class="vt-play-bg" d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2 0 34 0 34 0S12.8 0 7.5 1.6a8.6 8.6 0 0 0-6 6A89.6 89.6 0 0 0 0 24a89.6 89.6 0 0 0 1.5 16.3 8.6 8.6 0 0 0 6 6C12.8 48 34 48 34 48s21.2 0 26.5-1.6a8.6 8.6 0 0 0 6-6A89.6 89.6 0 0 0 68 24a89.6 89.6 0 0 0-1.5-16.3z"/><path d="M27 34l18-10-18-10z" fill="#fff"/></svg></span>
          <span class="vt-watch">Watch on YouTube</span>
        </a>
        <p class="vt-caption">How Karim Made His First $8,297 In 90 Days In Lebanon</p>
      </div>

      <div class="vt-card-outer">
        <span class="vt-pill">Rahma — Sales Manager</span>
        <a class="vt-card" href="https://youtu.be/AgI7SHIr2CU" target="_blank" rel="noopener" aria-label="Watch on YouTube">
          <img src="https://i.ytimg.com/vi/AgI7SHIr2CU/hqdefault.jpg" alt="" class="vt-thumb" loading="lazy" width="480" height="270" />
          <span class="vt-title">How She Generated $1,600 in 30 Days Selling a High-Ticket Product in Lebanon</span>
          <span class="vt-play"><svg viewBox="0 0 68 48" aria-hidden="true"><path class="vt-play-bg" d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2 0 34 0 34 0S12.8 0 7.5 1.6a8.6 8.6 0 0 0-6 6A89.6 89.6 0 0 0 0 24a89.6 89.6 0 0 0 1.5 16.3 8.6 8.6 0 0 0 6 6C12.8 48 34 48 34 48s21.2 0 26.5-1.6a8.6 8.6 0 0 0 6-6A89.6 89.6 0 0 0 68 24a89.6 89.6 0 0 0-1.5-16.3z"/><path d="M27 34l18-10-18-10z" fill="#fff"/></svg></span>
          <span class="vt-watch">Watch on YouTube</span>
        </a>
        <p class="vt-caption">How She Generated $1,600 in 30 Days Selling a High-Ticket Product in Lebanon</p>
      </div>

      <div class="vt-card-outer">
        <span class="vt-pill">Antoine — Software Engineer</span>
        <a class="vt-card" href="https://youtu.be/OxiSd1tXBwY" target="_blank" rel="noopener" aria-label="Watch on YouTube">
          <img src="https://i.ytimg.com/vi/OxiSd1tXBwY/hqdefault.jpg" alt="" class="vt-thumb" loading="lazy" width="480" height="270" />
          <span class="vt-title">He Spent Money on Ads and Failed… Here&#39;s What Went Wrong</span>
          <span class="vt-play"><svg viewBox="0 0 68 48" aria-hidden="true"><path class="vt-play-bg" d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2 0 34 0 34 0S12.8 0 7.5 1.6a8.6 8.6 0 0 0-6 6A89.6 89.6 0 0 0 0 24a89.6 89.6 0 0 0 1.5 16.3 8.6 8.6 0 0 0 6 6C12.8 48 34 48 34 48s21.2 0 26.5-1.6a8.6 8.6 0 0 0 6-6A89.6 89.6 0 0 0 68 24a89.6 89.6 0 0 0-1.5-16.3z"/><path d="M27 34l18-10-18-10z" fill="#fff"/></svg></span>
          <span class="vt-watch">Watch on YouTube</span>
        </a>
        <p class="vt-caption">He Spent Money on Ads and Failed… Here&#39;s What Went Wrong</p>
      </div>
    </div>
  </section>


  <!-- ═══════════ 3. WHO IS DROPARABIA FOR ═══════════ -->
  <section class="fit-section" aria-labelledby="fit-heading">
    <h2 class="fit-heading" id="fit-heading">Who is Droparabia for?</h2>
    <div class="fit-grid">
      <div class="fit-card fit-card--yes">
        <h3 class="fit-card-title">
          It's for you if:
        </h3>
        <ul class="fit-list fit-list--yes">
          <li>You're a Lebanese looking to build an online business next to your 9 to 5 or your studies</li>
          <li>You're an E-com enthusiast seeking a solution to owning inventories, managing them or ordering huge shipments from China</li>
          <li>You're struggling to build your own e-com business and want a system to help you step-by-step</li>
          <li>Tired of YouTube tutorials, TikTok/Instagram short guides and systems that only work for the US market and not the Lebanese market</li>
          <li>Ready to invest into starting your e-com business and you're willing to keep trying even if you fail at first</li>
        </ul>
      </div>

      <div class="fit-card fit-card--no">
        <h3 class="fit-card-title">
          It's ABSOLUTELY not for you if:
        </h3>
        <ul class="fit-list fit-list--no">
          <li>You're looking for a shortcut to become rich overnight</li>
          <li>Unwilling or unable to put any kind of effort or invest into building your own business</li>
          <li>You can't give it a consistent time every week</li>
        </ul>
      </div>
    </div>

  </section>


  <!-- ═══════════ 4. TRUSTPILOT REVIEWS ═══════════ -->
  <!-- Labelled on the section itself now that the heading is gone, so the reviews are
       still announced as a named region rather than an unlabelled block. -->
  <section class="tp-section" aria-label="What our users say on Trustpilot">
    <div class="tp-head">
      <img src="/Trustpilot_Logo_(2022).svg.png" alt="Trustpilot" class="tp-head-logo" width="300" height="74" loading="lazy" />
      <!-- Overall TrustScore as shown on Trustpilot (4.3), which Trustpilot draws as four
           full stars and a half. The span carries the label, so the image is decorative. -->
      <span class="tp-rating" role="img" aria-label="Rated 4.3 out of 5 on Trustpilot">
        <img src={STAR_BLOCKS['4.5']} alt="" aria-hidden="true" class="tp-stars-img tp-stars-img--head" width="512" height="96" loading="lazy" />
        <span class="tp-score">4.3</span>
      </span>
    </div>

    <div class="tp-grid">
      {trustpilotReviews.map((review) => (
        <article class="tp-card">
          <div class="tp-card-top">
            <span class="tp-name">{review.name}</span>
            <span class="tp-date">{review.date}</span>
          </div>
          <img src={STAR_BLOCKS[String(review.stars)]} alt={`Rated ${review.stars} out of 5 stars`} class="tp-stars-img" width="512" height="96" loading="lazy" />
          <p class="tp-text">{review.text}</p>
        </article>
      ))}
    </div>
  </section>


  <!-- ═══════════ FOOTER ═══════════ -->
  <!-- ═══════════ 5. FINAL CTA ═══════════ -->
  <!-- Last thing on the page. Sends them back up to the player rather than to the
       survey: the video is still the step that has to come first, and the gate on it
       is unchanged. -->
  <section class="final-cta">
    <div class="fit-cta">
      <h3 class="fit-cta-title">Droparabia is ready to help you build &amp; successfully launch your own e-commerce store</h3>
      <p class="fit-cta-note">The only thing missing is YOU to get started</p>
      <button type="button" class="fit-cta-btn" id="fit-cta-btn">
        Watch Free Training
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </div>
  </section>


  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo-link">
          <img src="/Droparabia.png" alt="Droparabia logo" class="footer-logo-img" />
          <span class="footer-logo-name">Droparabia</span>
        </a>
      </div>

      <div class="footer-links">
        <p class="footer-links-label">Legal</p>
        <div class="footer-compliance">
          <a href="/privacy-policy" class="footer-compliance-link">Privacy Policy</a>
          <a href="/terms" class="footer-compliance-link">Terms &amp; Conditions</a>
        </div>
      </div>

      <div class="footer-links">
        <p class="footer-links-label">Follow us</p>
        <div class="footer-socials">
          <a href="https://www.instagram.com/mjbusinessofficial?igsh=Mm5jdmFjMTljbm0x" target="_blank" rel="noopener" class="footer-social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d={siInstagram.path}/></svg>
          </a>
          <a href="https://www.threads.com/@mjbusinessofficial" target="_blank" rel="noopener" class="footer-social-link" aria-label="Threads">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d={siThreads.path}/></svg>
          </a>
          <a href="https://www.youtube.com/@MJ.biznes" target="_blank" rel="noopener" class="footer-social-link" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d={siYoutube.path}/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 Droparabia. All rights reserved.</p>
    </div>
  </footer>

  <!-- VSL Subscription Modal — opens when Plyr's play button is clicked while unsubscribed -->
  <div id="vsl-modal" class="vsl-modal-overlay" aria-hidden="true">
    <div class="vsl-modal-box" role="dialog" aria-modal="true" aria-labelledby="vsl-modal-title">
      <button class="vsl-modal-close" id="vsl-modal-close" aria-label="Close">&times;</button>
      <div class="vsl-modal-head">
        <h3 class="vsl-modal-title" id="vsl-modal-title">
          <span class="vsl-modal-title-sub">Subscribe to unlock this training for FREE</span>
        </h3>
        <p class="vsl-modal-warning">This Tutorial Might be taken down soon!</p>
      </div>
      <div id="vsl-error-msg" class="brevo-alert brevo-alert--error" style="display:none">Could not subscribe. Please try again.</div>
      <div id="vsl-success-msg" class="brevo-alert brevo-alert--success" style="display:none">Subscribed! Starting your video...</div>
      <form id="vsl-modal-form" class="vsl-modal-form" method="POST" action="/api/subscribe" data-type="subscription">
        <div class="field-line">
          <span class="field-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <input type="text" name="FIRSTNAME" placeholder="First and Last Name" required autocomplete="name" />
        </div>
        <div class="field-line">
          <span class="field-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <!-- type="email", not "text": as a plain text field Chrome's autofill treated
               this as a generic box and filled it with the surname, which Brevo then
               rejected as an invalid email. Also gives an email keyboard on mobile. -->
          <input type="email" name="EMAIL" placeholder="Your Best Email" required autocomplete="email" inputmode="email" />
        </div>
        <div class="field-line">
          <span class="field-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.31 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 5.45 5.45l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <PhoneCountrySelect inputId="vsl-modal-country" name="SMS__COUNTRY_CODE" variant="plain" />
          <span class="sms-divider">|</span>
          <input type="tel" name="SMS" placeholder="WhatsApp Number" required autocomplete="tel" />
        </div>
        <p id="vsl-modal-email-err" class="vsl-inline-err" style="display:none">Please enter a valid email address</p>
        <!-- Offered on blur, never applied on its own; submitting is not blocked by it. -->
        <p id="vsl-modal-email-typo" class="vsl-inline-typo" style="display:none">Did you mean <button type="button" class="vsl-typo-btn" id="vsl-modal-email-typo-btn"></button>?</p>
        <p id="vsl-modal-phone-err" class="vsl-inline-err" style="display:none">Please enter a valid phone number for the country you picked</p>
        <button type="submit" class="vsl-inline-btn">Start Watching!</button>
        <p class="vsl-inline-consent">By subscribing, you agree to receive future marketing messages and newsletters</p>
        <!-- Two honeypots. email_address_check is Brevo's own public field name, which a
             bot trained on Brevo forms may know to leave alone, so company_website sits
             beside it. Either one arriving filled is treated as a bot. -->
        <input type="text" name="email_address_check" value="" style="display:none">
        <input type="text" name="company_website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
        <input type="hidden" name="locale" value="en">
      </form>
    </div>
  </div>

</Layout>


