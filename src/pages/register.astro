---
const title = 'Customer Registration — Droparabia';
const description = 'Register a customer for their Droparabia subscription.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/Droparabia.png" type="image/png" />
    <link rel="shortcut icon" href="/Droparabia.png" type="image/png" />
    <link rel="apple-touch-icon" href="/Droparabia.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/ibrand.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main class="page">
      <a href="/" class="brand" aria-label="Droparabia">
        <img src="/Droparabia.png" alt="" class="brand-logo" width="72" height="72" />
        <span class="brand-name">Droparabia</span>
      </a>

      <div class="card">
        <h1 class="card-title">Register a customer</h1>
        <p class="card-sub">Enter the customer's details below to register their subscription.</p>

        <form id="register-form" class="form" novalidate>
          <div class="field-row">
            <div class="field field-name">
              <label for="first-name">Customer's first name</label>
              <input type="text" id="first-name" name="firstName" placeholder="First name" autocomplete="off" required />
            </div>
            <div class="field field-name">
              <label for="last-name">Customer's last name</label>
              <input type="text" id="last-name" name="lastName" placeholder="Last name" autocomplete="off" required />
            </div>
          </div>

          <div class="field">
            <label for="email">Customer's email</label>
            <input type="email" id="email" name="email" placeholder="customer@example.com" autocomplete="off" inputmode="email" required />
          </div>

          <div class="field">
            <label>Subscription type</label>
            <div class="plan-options">
              <label class="plan-option">
                <input type="radio" name="subscriptionType" value="12_months" checked />
                <span class="plan-option-label">12 Months</span>
              </label>
              <label class="plan-option">
                <input type="radio" name="subscriptionType" value="6_months" />
                <span class="plan-option-label">6 Months</span>
              </label>
            </div>
          </div>

          <p class="form-error" id="form-error">Something went wrong. Please check the details and try again.</p>
          <p class="form-success" id="form-success">Customer registered successfully.</p>

          <button type="submit" class="submit-btn" id="submit-btn">Register</button>
        </form>
      </div>
    </main>

    <script>
      const form = document.getElementById('register-form') as HTMLFormElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const errorEl = document.getElementById('form-error') as HTMLElement;
      const successEl = document.getElementById('form-success') as HTMLElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.style.display = 'none';
        successEl.style.display = 'none';

        const firstName = (document.getElementById('first-name') as HTMLInputElement).value.trim();
        const lastName = (document.getElementById('last-name') as HTMLInputElement).value.trim();
        const email = (document.getElementById('email') as HTMLInputElement).value.trim();
        const subscriptionType = (form.querySelector('input[name="subscriptionType"]:checked') as HTMLInputElement)?.value;

        if (!firstName || !lastName || !email || !subscriptionType) {
          errorEl.textContent = 'Please fill in every field.';
          errorEl.style.display = 'block';
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Registering…';

        try {
          const res = await fetch('/api/register-subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ firstName, lastName, email, subscriptionType }),
          });
          const data = await res.json();

          if (data.success) {
            // Its own page rather than an inline message, so there's room to tell them
            // to check the Promotions tab without crowding the form.
            window.location.href = '/register/success';
            return;
          } else {
            errorEl.textContent = 'Something went wrong. Please check your details and try again.';
            errorEl.style.display = 'block';
          }
        } catch {
          errorEl.textContent = 'Network error. Please try again.';
          errorEl.style.display = 'block';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Register';
        }
      });
    </script>

    <style is:global>
      @font-face {
        font-family: 'IBrand';
        src: url('/fonts/ibrand.woff2') format('woff2'),
             url('/fonts/ibrand.otf') format('opentype');
        font-weight: normal;
        font-style: normal;
        font-display: block;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --blue: #2563eb;
        --blue-hover: #1d4ed8;
        --blue-light: #eff6ff;
        --blue-mid: #dbeafe;
        --blue-border: #bfdbfe;
        --white: #ffffff;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-900: #0f172a;
        --red: #dc2626;
        --font-body: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        --font-brand: 'IBrand', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        --radius: 10px;
        --radius-lg: 16px;
      }

      html {
        background: var(--gray-50);
      }

      body {
        font-family: var(--font-body);
        color: var(--gray-900);
        background: var(--gray-50);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      img {
        max-width: 100%;
        display: block;
      }
    </style>

    <style>
      .page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: clamp(32px, 6vw, 64px) 20px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        margin-bottom: clamp(24px, 4vw, 40px);
      }

      .brand-logo {
        width: clamp(40px, 5vw, 56px);
        height: auto;
        object-fit: contain;
      }

      .brand-name {
        font-family: var(--font-brand);
        font-size: clamp(1.5rem, 3.4vw, 2rem);
        line-height: 1;
        color: var(--gray-900);
        letter-spacing: 0.01em;
      }

      .card {
        background: var(--white);
        border-radius: var(--radius-lg);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
        padding: clamp(24px, 4vw, 36px);
        width: 100%;
        max-width: 480px;
      }

      .card-title {
        font-family: var(--font-brand);
        font-weight: 400;
        font-size: 1.5rem;
        color: var(--gray-900);
        margin-bottom: 6px;
      }

      .card-sub {
        font-size: 0.9rem;
        color: var(--gray-500);
        margin-bottom: 24px;
      }

      .form {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .field-row {
        display: flex;
        gap: 10px;
        border: 1.5px solid var(--gray-200);
        border-radius: var(--radius);
        padding: 10px 12px;
        background: var(--white);
      }

      .field-row:focus-within {
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
      }

      .field-name {
        flex: 1;
        border: none;
        padding: 0;
      }

      .field-name + .field-name {
        border-left: 1px solid var(--gray-200);
        padding-left: 10px;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .field label {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--gray-600);
      }

      .field > input,
      .field-row input {
        border: none;
        outline: none;
        font-size: 0.95rem;
        font-family: var(--font-body);
        color: var(--gray-900);
        background: transparent;
        width: 100%;
      }

      .field:not(.field-name) > input {
        border: 1.5px solid var(--gray-200);
        border-radius: var(--radius);
        padding: 10px 12px;
      }

      .field:not(.field-name) > input:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
      }

      .plan-options {
        display: flex;
        gap: 10px;
      }

      .plan-option {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1.5px solid var(--gray-200);
        border-radius: var(--radius);
        padding: 10px 12px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--gray-600);
        transition: border-color 0.15s, background 0.15s;
      }

      .plan-option:has(input:checked) {
        border-color: var(--blue);
        background: var(--blue-light);
        color: var(--blue);
      }

      .plan-option input {
        width: 16px;
        height: 16px;
        flex: none;
        accent-color: var(--blue);
      }

      .form-error,
      .form-success {
        display: none;
        font-size: 0.85rem;
        border-radius: 8px;
        padding: 0.6rem 0.75rem;
      }

      .form-error {
        color: var(--red);
        background: #fef2f2;
        border: 1px solid #fca5a5;
      }

      .form-success {
        color: #15803d;
        background: #f0fdf4;
        border: 1px solid #86efac;
      }

      .submit-btn {
        padding: 0.8rem 1.5rem;
        background: linear-gradient(135deg, var(--blue), #3b82f6);
        color: var(--white);
        font-weight: 700;
        border-radius: var(--radius);
        border: none;
        cursor: pointer;
        font-size: 1rem;
        font-family: var(--font-body);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
      }

      .submit-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(37, 99, 235, 0.3);
      }

      .submit-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
      }

      @media (max-width: 420px) {
        .field-row {
          flex-direction: column;
          gap: 0;
        }

        .field-name + .field-name {
          border-left: none;
          border-top: 1px solid var(--gray-200);
          padding-left: 0;
          padding-top: 10px;
          margin-top: 10px;
        }
      }
    </style>
  </body>
</html>
