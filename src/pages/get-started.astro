<script>
  // Weekly spots left, counted server-side from this week's rows on the booked sheet.
  // The fallback text stays in place if the request fails.
  const spotsEl = document.getElementById('book-cta-spots');
  if (spotsEl) {
    fetch('/api/spots')
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then((data: { remaining?: number }) => {
        if (typeof data.remaining !== 'number') return;
        const n = data.remaining;
        spotsEl.textContent = n === 0
          ? 'No spots left this week'
          : n === 1
            ? '1 spot is available this week'
            : `${n} spots are available this week`;
      })
      .catch(() => {});
  }
</script>

<script>
  import Swiper from 'swiper';
  import { Navigation } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';

  // Initialised straight away, matching the official reviews page. The previous
  // IntersectionObserver deferral meant the carousel was still booting as it scrolled
  // into view, which is what made it feel less smooth than that one.
  document.querySelectorAll('.testimonials-swiper').forEach((swiperEl) => {
    const container = swiperEl.closest('.carousel-container');
    if (!container) return;
    new Swiper(swiperEl as HTMLElement, {
      modules: [Navigation],
      slidesPerView: 1,
      spaceBetween: 16,
      breakpoints: {
        600: { slidesPerView: 2, spaceBetween: 20 },
        1024: { slidesPerView: 3, spaceBetween: 24 },
      },
      loop: true,
      navigation: {
        nextEl: container.querySelector('.case-carousel-next') as HTMLElement,
        prevEl: container.querySelector('.case-carousel-prev') as HTMLElement,
      },
      pagination: false,
    });
  });
</script>
