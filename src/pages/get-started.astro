    .carousel-container { padding: 0 26px; }
    /* left:0/right:0 resolve to the container's outer edge regardless of its padding
       (padding never shifts that reference point for an absolutely-positioned child) —
       straddling that edge on mobile meant half the button hung off the viewport itself.
       Sitting fully inside instead, overlaid on the slide. */
    .case-carousel-nav { width: 36px; height: 36px; top: 50%; transform: translateY(-50%) !important; }
