    <!-- Token check + Calendly init -->
    <script is:inline>
      (function() {
        try {
          const tokens = JSON.parse(sessionStorage.getItem('userTokens') || '{}');
          // ?preview=1 skips the survey-qualification gate — for checking the page
          // itself (e.g. the Calendly widget) without needing a real qualified
          // session. Not documented/linked anywhere; only works if you already know
          // the param.
          const isPreview = new URLSearchParams(location.search).get('preview') === '1';
          if (tokens.qualified || isPreview) {
            document.getElementById('main-content').style.display = 'block';

            var userData = {};
            try { userData = JSON.parse(sessionStorage.getItem('userData') || '{}'); } catch(_) {}

            var phoneDigits = (userData.phone || '').replace(/[\s\-()+.]/g, '');
            if (phoneDigits.startsWith('00961')) phoneDigits = phoneDigits.slice(5);
            else if (phoneDigits.startsWith('961') && phoneDigits.length >= 10) phoneDigits = phoneDigits.slice(3);
            var phoneE164 = phoneDigits ? '+961' + phoneDigits : '';

            var params = new URLSearchParams();
            if (userData.name)  params.set('name', userData.name);
            if (userData.email) params.set('email', userData.email);
            if (phoneE164) { params.set('a2', phoneE164); }

            var calendlyUrl = 'https://calendly.com/d/cx6h-n22-cr7/45-min-droparabia-advisory-call';
            var query = params.toString().replace(/\+/g, '%20');
            if (query) calendlyUrl += '?' + query;

            Calendly.initInlineWidget({
              url: calendlyUrl,
              parentElement: document.getElementById('calendly-widget'),
            });
            // Hide loader once Calendly signals it's ready
            window.addEventListener('message', function onCalendlyLoad(e) {
              if (e.data && (e.data.event === 'calendly.profile_page_viewed' || e.data.event === 'calendly.event_type_viewed')) {
                document.getElementById('calendly-loader').style.display = 'none';
                document.getElementById('calendly-widget').style.display = 'block';
                window.removeEventListener('message', onCalendlyLoad);
              }
            });
            // Fallback: show after 5s regardless
            setTimeout(function() {
              document.getElementById('calendly-loader').style.display = 'none';
              document.getElementById('calendly-widget').style.display = 'block';
            }, 5000);
          } else {
            document.getElementById('no-access').style.display = 'flex';
          }
        } catch(_) {
          document.getElementById('no-access').style.display = 'flex';
        }
      })();
    </script>

    <!-- canvas-confetti CDN -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

    <!-- Confetti + conditional Brevo subscription -->
    <script is:inline>
document.addEventListener('DOMContentLoaded', function() {
        // Confetti
        setTimeout(function() {
          confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
          setTimeout(function() { confetti({ particleCount: 50, angle: 60,  spread: 55, origin: { x: 0 } }); }, 250);
          setTimeout(function() { confetti({ particleCount: 50, angle: 120, spread: 55, origin: { x: 1 } }); }, 400);
          setTimeout(function() { confetti({ particleCount: 30, spread: 100, decay: 0.91, scalar: 1.2, shapes: ['star'] }); }, 600);
          var end = Date.now() + 3000;
          (function frame() {
            confetti({ particleCount: 2, angle: 60, spread: 55, origin: { x: Math.random() }, colors: ['#3b82f6','#10b981','#f59e0b','#ef4444'] });
            if (Date.now() < end) requestAnimationFrame(frame);
          }());
        }, 300);
      });

      // A confirmed booking swaps the Calendly embed for the thank-you view on this page
      // (no redirect) and fires the Meta Pixel Schedule event with the survey tier.
      // The flags live on window so a second copy of this listener, or Calendly posting
      // the event twice, can't fire the conversion or subscribe the lead again.
      var callBooked = false;

      function showThankYouView() {
        var tier = 0;
        try { tier = Number(sessionStorage.getItem('da_tier')) || 0; } catch(_) {}
        try {
          if (typeof window.fbq === 'function') {
            if (tier) window.fbq('track', 'Schedule', { value: tier, currency: 'USD' });
            else window.fbq('track', 'Schedule');
          }
        } catch(_) {}

        var main = document.getElementById('main-content');
        var view = document.getElementById('thank-you-view');
        if (main) main.style.display = 'none';
        if (view) {
          var frame = view.querySelector('iframe[data-src]');
          if (frame && !frame.getAttribute('src')) frame.setAttribute('src', frame.getAttribute('data-src'));
          view.hidden = false;
        }
        window.scrollTo(0, 0);
      }

      if (!window.__daBookingListener) {
        window.__daBookingListener = true;
        window.addEventListener('message', function(e) {
          if (e.origin !== 'https://calendly.com') return;
          if (!(e.data && e.data.event === 'calendly.event_scheduled')) return;
          if (callBooked || window.__daBookingHandled) return;
          callBooked = true;
          window.__daBookingHandled = true;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'call_booked' });
          showThankYouView();

          // Prefer Calendly payload (always available), fall back to sessionStorage
          var invitee = (e.data.payload && e.data.payload.invitee) || {};
          var stored  = {};
          try { stored = JSON.parse(sessionStorage.getItem('userData') || '{}'); } catch(_) {}
          var name  = invitee.name  || stored.name  || '';
          var email = invitee.email || stored.email || '';
          var phone = stored.phone  || '';

          if (email) {
            var utmKeys = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'];
            var utms = {};
            utmKeys.forEach(function(k) { var v = sessionStorage.getItem(k); if (v) utms[k] = v; });
            var ref = sessionStorage.getItem('da_referrer') || '';
            var vsl = {};
            // sessionStorage first (frozen-at-survey, then this tab's live figure);
            // localStorage last, for a returning visitor whose session reset since
            // actually watching the VSL.
            try {
              vsl = JSON.parse(
                sessionStorage.getItem('da_vsl_at_survey') ||
                sessionStorage.getItem('da_vsl_watch') ||
                localStorage.getItem('da_vsl_watch_persist') ||
                '{}'
              );
            } catch(_) {}

            // What they answered on the survey, so the booked sheet shows it next to
            // their name instead of only on the row they left behind.
            var surveyAnswers = [];
            try { surveyAnswers = JSON.parse(sessionStorage.getItem('da_survey_answers') || '[]'); } catch(_) {}

            var payload = {
              name: name, email: email, phone: phone, list: 'booked', referrer: ref,
              cta_popup: sessionStorage.getItem('da_cta_popup') || '',
              headline: sessionStorage.getItem('da_headline_variant') || '',
              vsl_watched_seconds: vsl.watched || 0,
              vsl_furthest_seconds: vsl.furthest || 0,
              vsl_duration_seconds: vsl.duration || 0,
              survey_answers: surveyAnswers,
            };
            // Calendly lets them book under a different address than the one they gave
            // us earlier. Send the original too, otherwise their qualified_no_book row
            // (filed under that address) survives the move to the booked list.
            if (stored.email && stored.email.toLowerCase() !== email.toLowerCase()) payload.prev_email = stored.email;
            fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(Object.assign(payload, utms)),
              keepalive: true,
            }).catch(function() {});
          }
        });
      }

      window.addEventListener('beforeunload', function() {
        if (!callBooked) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'call_not_booked' });
        }
      });
    </script>

    <!-- Thank-you view FAQ expand/collapse animation -->
    <script is:inline>
      document.querySelectorAll('#thank-you-view .faq-item').forEach(function(details) {
        var summary = details.querySelector('summary');
        summary.addEventListener('click', function(e) {
          e.preventDefault();
          if (details.open) {
            var anim = details.animate(
              { height: [details.offsetHeight + 'px', summary.offsetHeight + 'px'] },
              { duration: 280, easing: 'ease' }
            );
            anim.onfinish = function() { details.removeAttribute('open'); };
          } else {
            details.setAttribute('open', '');
            var full = details.offsetHeight;
            details.animate(
              { height: [summary.offsetHeight + 'px', full + 'px'] },
              { duration: 280, easing: 'ease' }
            );
          }
        });
      });
    </script>

  </body>
</html>
