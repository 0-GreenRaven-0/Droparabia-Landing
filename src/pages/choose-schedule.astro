    <style>
      /* Thank-you view, adapted from the droparabia-thank-you project. Shown in place of
         the Calendly embed once a booking is confirmed; everything is scoped to it. */
      @font-face { font-family: 'IBrand'; src: url('/fonts/ibrand.woff2') format('woff2'), url('/fonts/ibrand.otf') format('opentype'); font-weight: normal; font-style: normal; font-display: swap; }
      #thank-you-view {
        --blue-start: #2563eb; --blue-end: #29b6f6; --bg-card: #f0f0f0; --text: #111118; --text-muted: #55556a;
        --border: rgba(37, 99, 235, 0.22); --radius-lg: 1.25rem; --radius-xl: 1.75rem;
        color: var(--text); font-family: 'DM Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 1rem; line-height: 1.65;
      }
      #thank-you-view .hl { font-family: 'IBrand', sans-serif; background: linear-gradient(90deg, var(--blue-start), var(--blue-end)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
      #thank-you-view .page-wrap { max-width: 760px; margin: 0 auto; padding: 0 1.25rem; }
      #thank-you-view .confirm-section { padding: 2.5rem 0 1.5rem; text-align: center; position: relative; overflow: hidden; }
      #thank-you-view .confirm-section::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(37,99,235,0.10) 0%, transparent 70%); pointer-events: none; }
      #thank-you-view .confirm-headline { font-family: 'IBrand', sans-serif; font-weight: normal; font-size: clamp(2.5rem, 7vw, 4.5rem); line-height: 1.05; letter-spacing: 0.01em; color: var(--text); margin-bottom: 0.4rem; }
      #thank-you-view .confirm-sub { font-size: clamp(1rem, 2.5vw, 1.2rem); color: var(--text-muted); font-weight: 400; }
      #thank-you-view .video-section { padding: 1rem 0 2rem; }
      #thank-you-view .section-label { text-align: center; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.6rem; }
      #thank-you-view .video-headline, #thank-you-view .faq-headline, #thank-you-view .step3-headline { font-family: 'IBrand', sans-serif; font-weight: normal; font-size: clamp(2rem, 5.5vw, 3.2rem); line-height: 1.1; text-align: center; }
      #thank-you-view .video-headline { margin-bottom: 1rem; }
      #thank-you-view .video-wrap { border-radius: var(--radius-xl); overflow: hidden; border: 2px solid #2563eb; box-shadow: 0 0 18px rgba(37,99,235,0.5), 0 0 40px rgba(37,99,235,0.2); background: #000; aspect-ratio: 16 / 9; }
      #thank-you-view .video-wrap iframe { width: 100%; height: 100%; border: 0; display: block; }
      #thank-you-view .faq-section { padding: 0 0 2.5rem; }
      #thank-you-view .faq-headline { margin-bottom: 1.25rem; }
      #thank-you-view .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
      #thank-you-view .faq-item { background: var(--bg-card); border: 1.5px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; transition: border-color 0.2s; will-change: height; }
      #thank-you-view .faq-item[open] { border-color: rgba(37, 99, 235, 0.5); }
      #thank-you-view .faq-item summary { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 1.2rem 1.4rem 1.6rem; font-size: 1rem; font-weight: 600; cursor: pointer; list-style: none; user-select: none; color: var(--text); }
      #thank-you-view .faq-item summary::-webkit-details-marker { display: none; }
      #thank-you-view .faq-arrow { flex-shrink: 0; width: 1.2rem; height: 1.2rem; color: var(--text-muted); transition: transform 0.25s ease; }
      #thank-you-view .faq-item[open] .faq-arrow { transform: rotate(180deg); }
      #thank-you-view .faq-body { padding: 1rem 1.4rem 1.3rem; color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; border-top: 1px solid var(--border); }
      #thank-you-view .step3-section { padding: 0 0 3rem; text-align: center; }
      #thank-you-view .step3-headline { margin-bottom: 0.6rem; }
      #thank-you-view .step3-sub { font-size: 1rem; color: var(--text-muted); max-width: 480px; margin: 0 auto 0.6rem; line-height: 1.6; }
