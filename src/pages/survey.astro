<html lang="en">
  <head>
    <script is:inline>window.dataLayer = window.dataLayer || [];</script>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-NTGWNM69');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <title>Get Started — Droparabia</title>
    <link rel="icon" type="image/png" href="/Droparabia.png" />
    <style>
      @font-face { font-family: 'IBrand'; src: url('/fonts/ibrand.otf') format('opentype'); font-weight: normal; font-style: normal; font-display: swap; }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', sans-serif; background: #F1F5F9; min-height: 100vh; -webkit-font-smoothing: antialiased; }
      .survey-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.25rem 1rem; min-height: 100svh; }
      .survey-card { background: #fff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); padding: 1.75rem; width: 100%; max-width: 680px; }
      .survey-title { color: #2563EB; font-size: 0.95rem; font-weight: 700; text-align: center; line-height: 1.5; margin-bottom: 1.25rem; }
      .survey-progress-track { background: #E2E8F0; height: 6px; border-radius: 999px; margin-bottom: 0.5rem; overflow: hidden; }
      .survey-progress-bar { background: linear-gradient(90deg, #2563EB, #3B82F6); height: 100%; border-radius: 999px; transition: width 0.5s ease; }
      .survey-page-count { color: #94A3B8; font-size: 0.9rem; margin-bottom: 1rem; }
      .survey-question { font-size: 1rem; font-weight: 600; color: #374151; margin-bottom: 1rem; line-height: 1.65; }
      .survey-options { display: flex; flex-direction: column; gap: 0.5rem; }
      .survey-option { display: flex; align-items: center; gap: 0.75rem; padding: 0.65rem 0.9rem; border-radius: 10px; border: 1.5px solid #E2E8F0; background: #fff; cursor: pointer; transition: border-color 0.15s, background 0.15s, transform 0.15s; font-weight: 500; color: #374151; font-size: 0.875rem; width: 100%; text-align: left; }
      .survey-option:hover { border-color: #93C5FD; background: #EFF6FF; transform: translateX(3px); }
      .survey-option.selected { border-color: #2563EB; background: #EFF6FF; box-shadow: 0 2px 8px rgba(37,99,235,0.12); }
      .survey-error { color: #DC2626; font-size: 0.85rem; background: #FEF2F2; border: 1px solid #FCA5A5; border-radius: 8px; padding: 0.5rem 0.75rem; margin-top: 0.75rem; display: none; }
      .survey-nav { display: flex; gap: 0.75rem; margin-top: 1.75rem; }
      .survey-btn { padding: 0.75rem 1.75rem; background: linear-gradient(135deg, #2563EB, #3B82F6); color: #fff; font-weight: 700; border-radius: 10px; border: none; cursor: pointer; font-size: 1rem; font-family: 'Inter', sans-serif; box-shadow: 0 4px 12px rgba(37,99,235,0.25); transition: transform 0.15s, box-shadow 0.15s; }
      .survey-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(37,99,235,0.3); }
      .survey-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
      .survey-btn-secondary { background: #fff; color: #2563EB; border: 2px solid #2563EB; box-shadow: none; }
      .survey-btn-secondary:hover { background: #EFF6FF; }
      .survey-page { display: none; }
      .survey-page.active { display: block; }
      @media (max-width: 768px) {
        body { background: #fff !important; }
        .survey-wrap { padding: 1rem 1.25rem; justify-content: flex-start; }
        .survey-card { background: transparent; box-shadow: none; border-radius: 0; padding: 1.25rem 0; max-width: 100%; }
      }
    </style>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NTGWNM69"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Loading overlay while subscribing -->
    <div id="survey-loader" style="display:flex; position:fixed; inset:0; background:#F1F5F9; z-index:999; flex-direction:column; align-items:center; justify-content:center; gap:1rem;">
      <div style="width:44px; height:44px; border:4px solid #E2E8F0; border-top-color:#2563EB; border-radius:50%; animation:spin 0.8s linear infinite;"></div>
      <p style="color:#6B7280; font-family:'Inter',sans-serif; font-size:1rem;">Just a moment...</p>
    </div>
    <style>@keyframes spin { to { transform: rotate(360deg); } }</style>

    <div class="survey-wrap" id="survey-content" style="display:none;">
      <div class="survey-card">

        <div style="text-align:center; margin-bottom:1.25rem;">
          <div style="display:flex; align-items:center; justify-content:center; gap:10px; margin-bottom:0.75rem;">
            <img src="/Droparabia.png" alt="Droparabia" style="height:72px;" />
            <span style="font-family:'IBrand', sans-serif; font-size:3rem; font-weight:400; color:#0f172a;">Droparabia</span>
          </div>
 
        </div>

        <div class="survey-progress-track">
          <div class="survey-progress-bar" id="progress-bar" style="width:12.5%"></div>
        </div>

        <!-- Q1 -->
        <div class="survey-page active" data-field="startingOrExploring">
          <h2 class="survey-question">Are you looking to start building an online business for yourself or you're just exploring?</h2>
          <div class="survey-options">
            <button class="survey-option" data-value="starting">Yes I wanna start an online business</button>
            <button class="survey-option" data-value="exploring">No, just looking around</button>
          </div>
          <div class="survey-error" id="err-1">Please select an option to continue</div>
        </div>

        <!-- Q2 -->
        <div class="survey-page" data-field="stopped" style="display:none">
          <h2 class="survey-question">What is currently stopping you from starting your very own online business?</h2>
          <div class="survey-options">
            <button class="survey-option" data-value="noPath">No clear path or strategy</button>
            <button class="survey-option" data-value="afraid">Afraid of risking my time and money</button>
            <button class="survey-option" data-value="neverThought">I never thought about it</button>
          </div>
          <div class="survey-error" id="err-2">Please select an option to continue</div>
        </div>

        <!-- Q3 -->
        <div class="survey-page" data-field="readyToStart" style="display:none">
          <h2 class="survey-question">If Droparabia gave you the tools which you can use to build the business + community and advisory support, would you be willing to get started?</h2>
          <div class="survey-options">
            <button class="survey-option" data-value="yes">Yes for sure!</button>
            <button class="survey-option" data-value="learnMore">I'd like to learn more first</button>
            <button class="survey-option" data-value="notInterested" data-end="true">Not interested at the moment</button>
          </div>
          <div class="survey-error" id="err-3">Please select an option to continue</div>
        </div>

        <!-- Q4 -->
        <div class="survey-page" data-field="budget" style="display:none">
          <h2 class="survey-question">We require our users to have a sufficient budget of $700-$1,000 for SaaS fees<br><br>Do you have the budget?</h2>
          <div class="survey-options">
            <button class="survey-option" data-value="yes">Yes I have the budget!</button>
            <button class="survey-option" data-value="partial">I have at least $700</button>
            <button class="survey-option" data-value="no" data-end="true">No I don't have the budget</button>
          </div>
          <div class="survey-error" id="err-4">Please select an option to continue</div>
        </div>

        <!-- Q5 -->
        <div class="survey-page" data-field="goalIncome" style="display:none">
          <h2 class="survey-question">What is your dream or monthly income goal?</h2>
          <div class="survey-options">
            <button class="survey-option" data-value="upTo1k">Up to $1,000</button>
            <button class="survey-option" data-value="1kTo3k">$1,000 – $3,000</button>
            <button class="survey-option" data-value="3kTo5k">$3,000 – $5,000</button>
            <button class="survey-option" data-value="5kPlus">$5,000+</button>
          </div>
          <div class="survey-error" id="err-5">Please select an option to continue</div>
        </div>

        <!-- Q6 -->
        <div class="survey-page" data-field="effort" style="display:none">
          <h2 class="survey-question">Droparabia and our community will provide you with the BEST support to help you launch and scale your business but only if you're willing to put in the effort (even if you fail at first)<br><br>Are you willing to work hard to achieve your goal?</h2>
          <div class="survey-options">
            <button class="survey-option" data-value="hardWork">Yes I am</button>
            <button class="survey-option" data-value="doMyBest">I'll do my best</button>
          </div>
          <div class="survey-error" id="err-6">Please select an option to continue</div>
        </div>

        <!-- Q7 -->
        <div class="survey-page" data-field="howSoon" style="display:none">
          <h2 class="survey-question">That's great! If you're qualified to access the Droparabia system (Plus our +20 hours courses which you get as a bonus), how soon can you start?</h2>
          <div class="survey-options">
            <button class="survey-option" data-value="today">Today</button>
            <button class="survey-option" data-value="asSoonAsICan">As soon as I can</button>
            <button class="survey-option" data-value="notReady" data-end="true">I'm not ready yet</button>
          </div>
          <div class="survey-error" id="err-7">Please select an option to continue</div>
        </div>

        <!-- Q8 -->
        <div class="survey-page" data-field="attendCall" style="display:none">
          <h2 class="survey-question">If we book you a call with one of our advisors, is there any chance you might not attend it?</h2>
          <div class="survey-options">
            <button class="survey-option" data-value="willAttend">I'll be sure to attend</button>
            <button class="survey-option" data-value="mightCancel">I'll let you know If i had to cancel</button>
          </div>
          <div class="survey-error" id="err-8">Please select an option to continue</div>
        </div>

        <div class="survey-nav">
          <button class="survey-btn survey-btn-secondary" id="btn-prev" style="display:none" onclick="prevPage()">← Previous</button>
          <button class="survey-btn" id="btn-next" onclick="nextPage()">Next →</button>
        </div>

      </div>
    </div>

    <script is:inline>
      var page = 0;
      var total = document.querySelectorAll('.survey-page').length;
      var answers = {};
      var answerIsEnd = {}; // field -> true if the currently selected option ends the survey early
      var pageHistory = [0]; // actual path taken, so Previous retraces skips correctly
      var submitted = false;

      function isValidEmail(raw) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(raw);
      }

      // How much of the VSL they'd watched at the moment they opened the survey.
      // Frozen here rather than read at submit time: going back to the video mid-survey
      // shouldn't change the answer to "how much did they watch before they hopped on".
      (function() {
        try {
          if (!sessionStorage.getItem('da_vsl_at_survey')) {
            // sessionStorage first (this tab actually watched it this session); fall
            // back to the localStorage copy for a returning visitor whose session
            // reset (closed the tab, came back later) since watching.
            var live = sessionStorage.getItem('da_vsl_watch') || localStorage.getItem('da_vsl_watch_persist');
            if (live) sessionStorage.setItem('da_vsl_at_survey', live);
          }
        } catch(_) {}
      })();

      // Mark survey as started and reveal it
      (function() {
        try {
          var tokens = JSON.parse(sessionStorage.getItem('userTokens') || '{}');
          tokens.takeSurvey = Math.random().toString(36).substring(2) + Date.now().toString(36);
          sessionStorage.setItem('userTokens', JSON.stringify(tokens));
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'survey_started' });
        } catch(_) {}

        document.getElementById('survey-loader').style.display = 'none';
        document.getElementById('survey-content').style.display = 'flex';
        updateUI();
      })();

      // Option selection
      document.querySelectorAll('.survey-options').forEach(function(opts) {
        opts.addEventListener('click', function(e) {
          var btn = e.target.closest('.survey-option');
          if (!btn) return;
          opts.querySelectorAll('.survey-option').forEach(function(b) { b.classList.remove('selected'); });
          btn.classList.add('selected');
          var pageEl = btn.closest('.survey-page');
          answers[pageEl.dataset.field] = btn.dataset.value;
          answerIsEnd[pageEl.dataset.field] = btn.dataset.end === 'true';
          var err = pageEl.querySelector('.survey-error');
          if (err) err.style.display = 'none';
        });
      });

      function updateUI() {
        var pages = document.querySelectorAll('.survey-page');
        pages.forEach(function(p, i) { p.style.display = i === page ? 'block' : 'none'; });
        document.getElementById('progress-bar').style.width = (((page + 1) / total) * 100) + '%';
        document.getElementById('btn-prev').style.display = page > 0 ? 'inline-block' : 'none';
        var btn = document.getElementById('btn-next');
        btn.textContent = page === total - 1 ? 'Complete ✓' : 'Next →';
      }

      function prevPage() {
        if (pageHistory.length > 1) {
          pageHistory.pop();
          page = pageHistory[pageHistory.length - 1];
          updateUI();
        }
      }

      // Name/email/phone were already collected before the VSL — reuse them instead
      // of asking for them again at the end of the survey.
      function storedUser() {
        try { return JSON.parse(sessionStorage.getItem('userData') || '{}'); } catch(_) { return {}; }
      }

      function completeSurvey() {
        if (submitted) return;
        submitted = true;

        var btn = document.getElementById('btn-next');
        btn.disabled = true;
        btn.textContent = 'Processing...';

        var user = storedUser();
        var nameVal  = user.name  || '';
        var emailVal = user.email || '';
        var phoneVal = user.phone || '';

        // Disqualified the moment any of the three "end the survey here" options is
        // picked (readyToStart, budget, howSoon) — regardless of how far they got
        // afterwards, or whether budget was ever reached at all.
        var qualified = !(answerIsEnd.readyToStart || answerIsEnd.budget || answerIsEnd.howSoon);

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'survey_completed', survey_qualified: qualified, user_name: nameVal, user_email: emailVal, user_phone: phoneVal });

        var tokens = {};
        try { tokens = JSON.parse(sessionStorage.getItem('userTokens') || '{}'); } catch(_) {}
        var token = Math.random().toString(36).substring(2) + Date.now().toString(36);
        tokens[qualified ? 'qualified' : 'unqualified'] = token;
        sessionStorage.setItem('userTokens', JSON.stringify(tokens));

        var dest = qualified ? '/choose-schedule' : '/get-free-program';

        // No stored contact info (they somehow reached the survey without the VSL
        // gate) — nothing to subscribe with, so just route them.
        if (!isValidEmail(emailVal)) {
          window.location.href = dest;
          return;
        }

        var list = qualified ? 'qualified_no_book' : 'unqualified';
        var utmKeys = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'];
        var utms = {};
        utmKeys.forEach(function(k) { var v = sessionStorage.getItem(k); if (v) utms[k] = v; });
        var ref = sessionStorage.getItem('da_referrer') || '';

        var vsl = {};
        try { vsl = JSON.parse(sessionStorage.getItem('da_vsl_at_survey') || '{}'); } catch(_) {}

        fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.assign({
            name: nameVal, email: emailVal, phone: phoneVal, list: list, referrer: ref,
            cta_popup: sessionStorage.getItem('da_cta_popup') || '',
            headline: sessionStorage.getItem('da_headline_variant') || '',
            vsl_watched_seconds: vsl.watched || 0,
            vsl_furthest_seconds: vsl.furthest || 0,
            vsl_duration_seconds: vsl.duration || 0,
          }, utms)),
        }).finally(function() {
          window.location.href = dest;
        });
      }

      function nextPage() {
        var pages = document.querySelectorAll('.survey-page');
        var pageEl = pages[page];
        var field = pageEl.dataset.field;

        if (!answers[field]) {
          var err = pageEl.querySelector('.survey-error');
          if (err) err.style.display = 'block';
          return;
        }

        // "End the survey here" options (readyToStart/notInterested, budget/no,
        // howSoon/notReady) submit right away and route them unqualified.
        if (answerIsEnd[field] || page === total - 1) {
          completeSurvey();
          return;
        }

        page++;
        pageHistory.push(page);
        updateUI();
      }

      window.addEventListener('beforeunload', function() {
        if (!submitted) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'survey_abandoned' });
        }
      });
    </script>
  </body>
</html>
